{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug FFApp",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/FFApp/bin/Debug/net10.0/FFApp.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/FFApp",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Run FFApp (Release)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-release",
      "program": "${workspaceFolder}/src/FFApp/bin/Release/net10.0/FFApp.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/FFApp",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Debug Tests",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/tests/FFApp.Tests/FFApp.Tests.csproj",
        "--no-build"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
