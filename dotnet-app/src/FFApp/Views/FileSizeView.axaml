<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:ctrl="using:FFApp.Controls"
             x:Class="FFApp.Views.FileSizeView"
             x:CompileBindings="True"
             x:DataType="vm:FileSizeViewModel">

    <StackPanel Spacing="4">
        <!-- Target Size -->
        <Grid ColumnDefinitions="85,*">
            <TextBlock Text="Target (MB)" VerticalAlignment="Center" />
            <ctrl:NoWheelNumericUpDown Grid.Column="1"
                Value="{Binding TargetSizeMb}"
                Minimum="1" Maximum="10000"
                Increment="1" FormatString="N0" />
        </Grid>

        <!-- Two-pass -->
        <CheckBox Content="Use 2-pass encode"
                  IsChecked="{Binding TwoPass}"
                  Margin="85,0,0,0" />
    </StackPanel>
</UserControl>
