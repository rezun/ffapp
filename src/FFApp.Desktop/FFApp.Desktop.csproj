<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia building blocks shared by FFApp and FFRux: app identity, single instance,
       launch-file handling, theme tokens, global styles and small input controls. -->
  <PropertyGroup>
    <RootNamespace>FFApp</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FFApp.Shared.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
</Project>
