<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:FFApp.Controls"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:views="using:FFApp.Views"
              x:Class="FFApp.App"
              RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://FFApp/Themes/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Override Fluent's 32px CheckBox/RadioButton min height so their
                 internal glyph-grid (which uses this resource as a fixed Height)
                 shrinks to match our compact 22px sizing. Without this override,
                 overriding MinHeight via a Style has no effect on the internal
                 glyph positioning, leaving the box visually offset from inline
                 siblings like ComboBox/TextBox. -->
            <x:Double x:Key="CheckBoxMinHeight">22</x:Double>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />

        <Style Selector=":is(Control)">
            <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
            <!-- Use full-size, persistent scrollbars, including in control templates. -->
            <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="MaxWidth" Value="420" />
        </Style>
        <Style Selector="ToolTip /template/ ContentPresenter">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Compact global defaults -->
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="SplitButton">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Pin height only for single-line TextBoxes; multi-line must grow. -->
        <Style Selector="TextBox[AcceptsReturn=False]">
            <Setter Property="Height" Value="26" />
        </Style>
        <Style Selector="TextBox.numeric-input">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="MinHeight" Value="22" />
        </Style>
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,-10,0,0" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Single-line numeric editors must not expose the persistent scrollbars
             used elsewhere in the app. The separate value spinner stays available. -->
        <Style Selector="NumericUpDown /template/ TextBox">
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        </Style>

        <!-- Card-style sections: semantic surface with visible border -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Nested card (encoder tuning etc.) -->
        <Style Selector="Border.nested-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceNestedCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <!-- Dirty indicators for trim/crop nested cards -->
        <Style Selector="Border.nested-card.trim-dirty">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Border.nested-card.crop-dirty">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>

        <!-- Section header text inside cards -->
        <Style Selector="TextBlock.card-header">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="8,6,8,4" />
            <Setter Property="Foreground" Value="{DynamicResource CardHeaderBrush}" />
        </Style>

        <!-- Nested card header text -->
        <Style Selector="TextBlock.nested-card-header">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="8,6,8,4" />
            <Setter Property="Foreground" Value="{DynamicResource NestedCardHeaderBrush}" />
        </Style>

        <!-- Hyperlink-style button: text-only, no chrome -->
        <Style Selector="Button.hyperlink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.hyperlink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        </Style>
        <Style Selector="Button.hyperlink:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Danger button (red) -->
        <Style Selector="Button.danger /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonDangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonDangerBrush}" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonDangerHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonDangerHoverBrush}" />
        </Style>

        <!-- Warning button (yellow/amber) -->
        <Style Selector="Button.warning /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonWarningBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonWarningForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonWarningBrush}" />
        </Style>
        <Style Selector="Button.warning:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonWarningHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonWarningHoverBrush}" />
        </Style>

        <!-- Separators: subtle but visible -->
        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- Window background -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        </Style>

        <!-- TabControl styling -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="TabControl">
            <Setter Property="Padding" Value="2" />
        </Style>

        <!-- Panel header text (column titles) -->
        <Style Selector="TextBlock.panel-header">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource CardHeaderBrush}" />
        </Style>

        <!-- Dense text size variant -->
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBox.caption">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="SelectableTextBlock.caption">
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Secondary (de-emphasized) text role -->
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <!-- Explicit text roles must follow the theme's selection foreground. -->
        <Style Selector="ListBoxItem:selected TextBlock" x:CompileBindings="False">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
        </Style>

        <!-- Monospace text for numeric/timecode values -->
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,monospace" />
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,monospace" />
        </Style>
        <Style Selector="SelectableTextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,monospace" />
        </Style>

        <!-- Compact text input (24px, tight padding) -->
        <Style Selector="TextBox.compact">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Small / extra-small button variants (keep global MinHeight=26) -->
        <Style Selector="Button.sm">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="SplitButton.sm">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="SplitButton.accent">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
        </Style>
        <Style Selector="SplitButton.accent /template/ Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushPointerOver}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPointerOver}" />
        </Style>
        <Style Selector="SplitButton.accent /template/ Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushPressed}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPressed}" />
        </Style>
        <Style Selector="SplitButton.accent /template/ Button:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundDisabled}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushDisabled}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundDisabled}" />
        </Style>
        <Style Selector="Button.xs">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,1" />
        </Style>

        <!-- Compact checkbox (dense inline variant) -->
        <Style Selector="CheckBox.compact">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Application.Styles>
    <Application.DataTemplates>
        <DataTemplate DataType="vm:DependencySetupViewModel"><views:DependencySetupView /></DataTemplate>
        <DataTemplate DataType="vm:WorkspaceViewModel"><views:WorkspaceView /></DataTemplate>
        <DataTemplate DataType="vm:FileSizeViewModel"><views:FileSizeView /></DataTemplate>
        <DataTemplate DataType="vm:BitrateViewModel"><views:BitrateView /></DataTemplate>
        <DataTemplate DataType="vm:QualityViewModel"><views:QualityView /></DataTemplate>
    </Application.DataTemplates>
</Application>
