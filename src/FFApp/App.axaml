<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:FFApp.Controls"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:views="using:FFApp.Views"
              x:Class="FFApp.App"
              RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://FFApp/Themes/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />

        <!-- Compact global defaults -->
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBox.numeric-input">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="MinHeight" Value="22" />
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="MinHeight" Value="22" />
        </Style>
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,-10,0,0" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Card-style sections: semantic surface with visible border -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Nested card (encoder tuning etc.) -->
        <Style Selector="Border.nested-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceNestedCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <!-- Dirty indicators for trim/crop nested cards -->
        <Style Selector="Border.nested-card.trim-dirty">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Border.nested-card.crop-dirty">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>

        <!-- Section header text inside cards -->
        <Style Selector="TextBlock.card-header">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="8,6,8,4" />
            <Setter Property="Foreground" Value="{DynamicResource CardHeaderBrush}" />
        </Style>

        <!-- Nested card header text -->
        <Style Selector="TextBlock.nested-card-header">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="8,6,8,4" />
            <Setter Property="Foreground" Value="{DynamicResource NestedCardHeaderBrush}" />
        </Style>

        <!-- Hyperlink-style button: text-only, no chrome -->
        <Style Selector="Button.hyperlink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.hyperlink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        </Style>
        <Style Selector="Button.hyperlink:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Danger button (red) -->
        <Style Selector="Button.danger /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonDangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonDangerBrush}" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonDangerHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonDangerHoverBrush}" />
        </Style>

        <!-- Warning button (yellow/amber) -->
        <Style Selector="Button.warning /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonWarningBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonWarningForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonWarningBrush}" />
        </Style>
        <Style Selector="Button.warning:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonWarningHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonWarningHoverBrush}" />
        </Style>

        <!-- Separators: subtle but visible -->
        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- Window background -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        </Style>

        <!-- TabControl styling -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="TabControl">
            <Setter Property="Padding" Value="2" />
        </Style>

        <!-- Panel header text (column titles) -->
        <Style Selector="TextBlock.panel-header">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource CardHeaderBrush}" />
        </Style>
    </Application.Styles>
    <Application.DataTemplates>
        <DataTemplate DataType="vm:DependencySetupViewModel"><views:DependencySetupView /></DataTemplate>
        <DataTemplate DataType="vm:WorkspaceViewModel"><views:WorkspaceView /></DataTemplate>
        <DataTemplate DataType="vm:FileSizeViewModel"><views:FileSizeView /></DataTemplate>
        <DataTemplate DataType="vm:BitrateViewModel"><views:BitrateView /></DataTemplate>
        <DataTemplate DataType="vm:QualityViewModel"><views:QualityView /></DataTemplate>
    </Application.DataTemplates>
</Application>
