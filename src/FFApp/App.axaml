<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:FFApp.Controls"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:views="using:FFApp.Views"
              x:Class="FFApp.App"
              RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://FFApp.Desktop/Themes/Tokens.axaml" />
                <ResourceInclude Source="avares://FFApp.Desktop/Themes/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://FFApp.Desktop/Themes/Styles.axaml" />

        <!-- Dirty indicators for trim/crop nested cards -->
        <Style Selector="Border.nested-card.trim-dirty">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Border.nested-card.crop-dirty">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
    </Application.Styles>
    <Application.DataTemplates>
        <DataTemplate DataType="vm:DependencySetupViewModel"><views:DependencySetupView /></DataTemplate>
        <DataTemplate DataType="vm:WorkspaceViewModel"><views:WorkspaceView /></DataTemplate>
        <DataTemplate DataType="vm:FileSizeViewModel"><views:FileSizeView /></DataTemplate>
        <DataTemplate DataType="vm:BitrateViewModel"><views:BitrateView /></DataTemplate>
        <DataTemplate DataType="vm:QualityViewModel"><views:QualityView /></DataTemplate>
    </Application.DataTemplates>
</Application>
