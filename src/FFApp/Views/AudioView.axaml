<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:ctrl="using:FFApp.Controls"
             xmlns:models="using:FFApp.Core.Models"
             xmlns:conv="using:FFApp.Converters"
             x:Class="FFApp.Views.AudioView"
             x:CompileBindings="True"
             x:DataType="vm:AudioViewModel">

    <UserControl.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
    </UserControl.Resources>

    <StackPanel Spacing="4">

        <!-- Audio Mode -->
        <Grid ColumnDefinitions="85,*">
            <TextBlock Text="Audio mode" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <RadioButton Content="Copy" GroupName="AudioMode"
                    ToolTip.Tip="Copy selected audio tracks without re-encoding. Preserves their quality and requires a compatible output container."
                    IsChecked="{Binding SelectedAudioMode,
                        Converter={StaticResource EnumToBool},
                        ConverterParameter={x:Static models:AudioMode.Copy}}" />
                <RadioButton Content="Re-encode" GroupName="AudioMode"
                    ToolTip.Tip="Encode selected audio tracks with the codec, bitrate, channel count and sample rate chosen below."
                    IsChecked="{Binding SelectedAudioMode,
                        Converter={StaticResource EnumToBool},
                        ConverterParameter={x:Static models:AudioMode.Reencode}}" />
                <RadioButton Content="Remove" GroupName="AudioMode"
                    ToolTip.Tip="Exclude all audio tracks from the output."
                    IsEnabled="{Binding IsRemoveAllowed}"
                    IsChecked="{Binding SelectedAudioMode,
                        Converter={StaticResource EnumToBool},
                        ConverterParameter={x:Static models:AudioMode.Remove}}" />
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="85,*" IsVisible="{Binding IsTrackSelectionVisible}">
            <TextBlock Text="Tracks" VerticalAlignment="Top" Margin="0,6,0,0" />
            <StackPanel Grid.Column="1" Spacing="4">
                <CheckBox Content="All" IsChecked="{Binding AllAudioTracks}"
                    ToolTip.Tip="Include every audio track. Turn off to choose individual tracks; this selection applies to the current source rather than the preset." />
                <StackPanel Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding IsCustomTrackSelection}">
                    <Button Content="Select all" Command="{Binding SelectAllTracksCommand}"
                        ToolTip.Tip="Include all listed audio tracks in the current custom selection." />
                    <Button Content="Deselect all" Command="{Binding DeselectAllTracksCommand}"
                        ToolTip.Tip="Exclude all listed audio tracks from the current custom selection." />
                </StackPanel>
                <ScrollViewer MaxHeight="180" IsVisible="{Binding IsCustomTrackSelection}"
                              HorizontalAlignment="Left"
                              IsScrollChainingEnabled="False">
                    <ItemsControl ItemsSource="{Binding AudioTracks}" Margin="0,0,8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AudioTrackViewModel">
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                    ToolTip.Tip="Include this audio track in the output. Unchecked tracks are excluded when copying or re-encoding audio." />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="RemoveTrackTitlesCheckBox"
                  Content="Remove track titles" Margin="85,0,0,0"
                  IsVisible="{Binding IsAudioIncluded}"
                  IsChecked="{Binding RemoveTrackTitles}"
                  ToolTip.Tip="Remove titles from all included audio tracks when copying or re-encoding. Keeps language tags and other audio metadata." />

        <!-- Re-encode controls (visible only in Reencode mode) -->
        <StackPanel Spacing="4" IsVisible="{Binding IsReencodeMode}">
            <Grid ColumnDefinitions="85,Auto,16,75,*">
                <TextBlock Text="Audio codec" VerticalAlignment="Center" />
                <ctrl:NoWheelComboBox Grid.Column="1"
                    ToolTip.Tip="Choose the audio compression format. Available codecs depend on the output container and playback support."
                    Width="104"
                    ItemsSource="{Binding AvailableAudioCodecs}"
                    SelectedItem="{Binding SelectedAudioCodec}">
                    <ctrl:NoWheelComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:AudioCodec">
                            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.AudioCodec}}" />
                        </DataTemplate>
                    </ctrl:NoWheelComboBox.ItemTemplate>
                </ctrl:NoWheelComboBox>
                <TextBlock Grid.Column="3" Text="Bitrate" VerticalAlignment="Center" />
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Left">
                    <ctrl:NoWheelComboBox
 ToolTip.Tip="Target audio bitrate per track, in kbps. Higher values usually retain more detail and increase file size. Custom lets you enter a value."                        Width="104"
                        ItemsSource="{Binding AvailableBitrateOptions}"
                        SelectedItem="{Binding SelectedBitrateOption}">
                        <ctrl:NoWheelComboBox.ItemTemplate>
                            <DataTemplate x:DataType="x:Int32">
                                <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.AudioBitrateOption}}" />
                            </DataTemplate>
                        </ctrl:NoWheelComboBox.ItemTemplate>
                    </ctrl:NoWheelComboBox>
                    <ctrl:NumericTextBox x:Name="CustomBitrateBox"
                                         ToolTip.Tip="Enter the target audio bitrate per track in kbps. The chosen audio codec determines the supported range."
                                         Classes="numeric-input"
                                         Text="{Binding CustomBitrateText}"
                                         PlaceholderText="kbps"
                                         Width="50"
                                         IsVisible="{Binding IsCustomBitrate}" />
                </StackPanel>
            </Grid>

            <!-- Audio channels and sample rate -->
            <Grid ColumnDefinitions="85,Auto,16,75,*">
                <TextBlock Text="Channels" VerticalAlignment="Center" />
                <ctrl:NoWheelComboBox Grid.Column="1"
                    ToolTip.Tip="Choose the output channel count. Auto keeps the source channel count; fewer channels downmix the audio."
                    Width="104"
                    ItemsSource="{Binding AvailableAudioChannelOptions}"
                    SelectedItem="{Binding SelectedAudioChannels}">
                    <ctrl:NoWheelComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:Int32">
                            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.AudioChannelOption}}" />
                        </DataTemplate>
                    </ctrl:NoWheelComboBox.ItemTemplate>
                </ctrl:NoWheelComboBox>
                <TextBlock Grid.Column="3" Text="Sample rate" VerticalAlignment="Center" />
                <ctrl:NoWheelComboBox x:Name="SampleRateComboBox" Grid.Column="4"
                    Width="104"
                    HorizontalAlignment="Left"
                    ToolTip.Tip="Output samples per second, in Hz. Auto lets the encoder choose a supported rate; the listed rates are supported by the selected codec."
                    ItemsSource="{Binding AvailableSampleRateOptions}"
                    SelectedItem="{Binding SelectedSampleRate}">
                    <ctrl:NoWheelComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:Int32">
                            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.AudioSampleRateOption}}" />
                        </DataTemplate>
                    </ctrl:NoWheelComboBox.ItemTemplate>
                </ctrl:NoWheelComboBox>
            </Grid>

            <!-- Optional audio filtergraph (-af) -->
            <Grid ColumnDefinitions="85,*">
                <TextBlock Text="Audio filter" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding AudioFilter}"
                         PlaceholderText="e.g. loudnorm"
                         ToolTip.Tip="Optional FFmpeg audio filtergraph passed as -af and applied to every re-encoded audio track, for example loudnorm or volume=2dB. Leave empty to apply no filter." />
            </Grid>
        </StackPanel>

    </StackPanel>
</UserControl>
