<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:ctrl="using:FFApp.Controls"
             x:Class="FFApp.Views.BitrateView"
             x:CompileBindings="True"
             x:DataType="vm:BitrateViewModel">

    <Grid ColumnDefinitions="85,Auto,*" RowDefinitions="Auto,Auto">
        <TextBlock Text="Bitrate (kbps)" VerticalAlignment="Center" />
        <ctrl:NumericTextBox Grid.Column="1"
            Classes="numeric-input"
            Text="{Binding VideoBitrateKbpsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
            Width="120"
            Margin="0,0,12,0" />
        <CheckBox Grid.Column="2"
                  Content="Use 2-pass encode"
                  IsChecked="{Binding TwoPass}"
                  VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.Column="1"
                   Classes="caption secondary"
                   Text="{Binding EstimatedFileSizeText}"
                   IsVisible="{Binding HasEstimatedFileSize}"
                   Margin="0,2,12,0" />
    </Grid>
</UserControl>
