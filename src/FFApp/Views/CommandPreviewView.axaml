<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             x:Class="FFApp.Views.CommandPreviewView"
             x:CompileBindings="True"
             x:DataType="vm:CommandPreviewViewModel">

    <Border Classes="card" Margin="8,0,8,8">
        <DockPanel>
            <!-- Header: always visible -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="8,6,8,4">
                <TextBlock Text="Command Preview"
                           Classes="card-header" Margin="0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="Copied to clipboard"
                           IsVisible="{Binding ShowCopiedIndicator}"
                           Foreground="{DynamicResource SystemAccentColor}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <Button Grid.Column="2"
                        Content="Copy"
                        Command="{Binding CopyCommandCommand}"
                        IsEnabled="{Binding HasCommands}"
                        ToolTip.Tip="Copy command to clipboard"
                        Padding="8,2"
                        FontSize="11"
                        Margin="0,0,4,0" />
                <Button Grid.Column="3"
                        Content="Copy Template"
                        Command="{Binding CopyTemplateCommand}"
                        IsEnabled="{Binding HasCommands}"
                        ToolTip.Tip="Copy command with $input placeholder instead of actual paths"
                        Padding="8,2"
                        FontSize="11"
                        Margin="0,0,4,0" />
                <Button Grid.Column="4"
                        Content="{Binding IsExpanded, Converter={x:Static vm:CommandPreviewViewModel.ExpandCollapseConverter}}"
                        Command="{Binding ToggleExpandedCommand}"
                        Padding="8,2"
                        FontSize="11" />
            </Grid>
            <Separator DockPanel.Dock="Top" IsVisible="{Binding IsExpanded}" />

            <!-- Expandable content -->
            <TextBox IsVisible="{Binding IsExpanded}"
                     Text="{Binding CommandText, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                     FontSize="12"
                     MaxHeight="200"
                     Margin="8,4,8,8"
                     Watermark="Load a source file to preview commands." />
        </DockPanel>
    </Border>
</UserControl>
