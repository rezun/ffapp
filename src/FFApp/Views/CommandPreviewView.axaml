<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             x:Class="FFApp.Views.CommandPreviewView"
             x:CompileBindings="True"
             x:DataType="vm:CommandPreviewViewModel">

    <Expander IsExpanded="False"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              Padding="4,0"
              Margin="6,4,6,0">
        <Expander.Header>
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Command Preview"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Copy" Command="{Binding CopyCommandCommand}"
                        IsEnabled="{Binding HasCommands}"
                        ToolTip.Tip="Copy command to clipboard" />
            </Grid>
        </Expander.Header>

        <TextBox Text="{Binding CommandText, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                 FontSize="12"
                 MaxHeight="200"
                 Watermark="Load a source file to preview commands." />
    </Expander>
</UserControl>
