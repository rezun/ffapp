<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             x:Class="FFApp.Views.ComparisonPlaybackView"
             x:DataType="vm:ComparisonPlaybackViewModel" x:CompileBindings="True">
    <UserControl.Styles>
        <Style Selector="Border.splitLabel">
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.splitLabel > TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Panel#SplitOverlay:focus-visible > Border#SplitHandle">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="*,Auto,Auto,Auto">
        <Grid x:Name="VideoGrid" ColumnDefinitions="*,*" MinHeight="160">
            <Border x:Name="LeftPane" Background="Black" Margin="0,0,3,0" ClipToBounds="True">
                <Grid>
                    <Image x:Name="LeftFrame" IsVisible="{Binding HasFrames}" />
                </Grid>
            </Border>
            <Border x:Name="RightPane" Grid.Column="1" Background="Black" Margin="3,0,0,0" ClipToBounds="True">
                <Grid>
                    <Image x:Name="RightFrame" IsVisible="{Binding HasFrames}" />
                </Grid>
            </Border>
            <Panel x:Name="SplitOverlay" Grid.ColumnSpan="2" Background="Transparent" Focusable="True"
                   Cursor="SizeWestEast" IsVisible="{Binding IsSliderLayout}"
                   ToolTip.Tip="Drag to compare A and B. Use the arrow keys to fine-tune and double-click to center.">
                <Border x:Name="SplitDivider" Width="2" Background="White" HorizontalAlignment="Left"
                        IsHitTestVisible="False" />
                <Border x:Name="SplitHandle" Width="22" Height="22" CornerRadius="11" Background="White"
                        BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <TextBlock Text="◀▶" FontSize="8" Foreground="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Classes="splitLabel" HorizontalAlignment="Left" IsHitTestVisible="False">
                    <TextBlock Text="A" />
                </Border>
                <Border Classes="splitLabel" HorizontalAlignment="Right" IsHitTestVisible="False">
                    <TextBlock Text="B" />
                </Border>
            </Panel>
        </Grid>
        <ContentControl x:Name="OverviewHost" Grid.Row="1" Margin="0,10,0,0" IsVisible="{Binding $self.Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Grid Grid.Row="2" ColumnDefinitions="52,*" Margin="0,4,0,0">
            <TextBlock Text="Sample" Classes="secondary caption" VerticalAlignment="Center" />
            <Slider x:Name="PositionSlider" Grid.Column="1" Margin="0" Minimum="0" Maximum="{Binding DurationSeconds}"
                    Value="{Binding PositionSeconds}" IsEnabled="{Binding HasMedia}"
                    ToolTip.Tip="Seek both previews to the same position inside this sample." />
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,2,0,0">
            <StackPanel Orientation="Horizontal" Spacing="2" IsEnabled="{Binding HasMedia}">
                <Button x:Name="StepBackwardButton" Classes="icon"
                        Command="{Binding StepBackwardCommand}" ToolTip.Tip="Step back one frame">
                    <PathIcon Data="{StaticResource IconStepBackward}" />
                </Button>
                <Button x:Name="SeekBackwardButton" Classes="icon"
                        Command="{Binding SeekBackwardCommand}" ToolTip.Tip="Seek back one second">
                    <PathIcon Data="{StaticResource IconRewind}" />
                </Button>
                <Button x:Name="PlaySampleButton" Classes="icon emphasis" Command="{Binding TogglePlayCommand}"
                        ToolTip.Tip="{Binding PlayLabel}" AutomationProperties.Name="{Binding PlayLabel}">
                    <Panel>
                        <PathIcon Data="{StaticResource IconPlay}" IsVisible="{Binding !IsPlaying}" />
                        <PathIcon Data="{StaticResource IconPause}" IsVisible="{Binding IsPlaying}" />
                    </Panel>
                </Button>
                <Button x:Name="SeekForwardButton" Classes="icon"
                        Command="{Binding SeekForwardCommand}" ToolTip.Tip="Seek forward one second">
                    <PathIcon Data="{StaticResource IconFastForward}" />
                </Button>
                <Button x:Name="StepForwardButton" Classes="icon"
                        Command="{Binding StepForwardCommand}" ToolTip.Tip="Step forward one frame">
                    <PathIcon Data="{StaticResource IconStepForward}" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center"
                        ToolTip.Tip="Position inside the sample. Comparisons play without audio.">
                <TextBlock x:Name="PositionText" Text="{Binding PositionDisplay}" Classes="mono" />
                <TextBlock Text="{Binding DurationDisplay}" Classes="mono secondary" />
            </StackPanel>
            <TextBlock x:Name="PlaybackStatus" Grid.Column="2" Text="{Binding Status}" Classes="secondary caption"
                       Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Status}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                <ToggleButton x:Name="LoopButton" Classes="icon" IsChecked="{Binding Loop}"
                              ToolTip.Tip="Loop the sample">
                    <PathIcon Data="{StaticResource IconRepeat}" />
                </ToggleButton>
                <ComboBox ItemsSource="{Binding LayoutOptions}" SelectedItem="{Binding Layout}" MinWidth="112"
                          IsVisible="{Binding !IsSourcePreview}"
                          ToolTip.Tip="Switch between side-by-side, slider, A and B without changing playback position." />
                <ComboBox ItemsSource="{Binding ZoomOptions}" SelectedItem="{Binding Zoom}" MinWidth="76"
                          ToolTip.Tip="Use the same zoom for both views. 100% displays source pixels at native size, centered in each pane." />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
