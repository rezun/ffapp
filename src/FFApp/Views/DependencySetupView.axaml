<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FFApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="FFApp.Views.DependencySetupView"
             x:CompileBindings="True"
             x:DataType="vm:DependencySetupViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel HorizontalAlignment="Stretch" MaxWidth="660" Margin="24" Spacing="12">

        <TextBlock Text="Tools and components"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />

        <TextBlock Text="FFmpeg and ffprobe 9 or newer are required. Leave a path empty to search automatically. Optional components do not block encoding."
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

        <!-- ffmpeg path -->
        <StackPanel Spacing="4">
            <TextBlock Text="ffmpeg path" FontWeight="SemiBold" />
            <DockPanel>
                <Button Content="Browse..."
                        ToolTip.Tip="Select the installed FFmpeg executable."
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Command="{Binding BrowseFfmpegCommand}" />
                <TextBox Text="{Binding FfmpegPath, Mode=TwoWay}"
                         ToolTip.Tip="Path to the FFmpeg executable used to encode media. Required. Use Browse to select your installed executable."
                         PlaceholderText="/usr/bin/ffmpeg" />
            </DockPanel>
            <TextBlock Text="{Binding FfmpegStatus}" TextWrapping="Wrap" Classes="secondary" />
        </StackPanel>

        <!-- ffprobe path -->
        <StackPanel Spacing="4">
            <TextBlock Text="ffprobe path" FontWeight="SemiBold" />
            <DockPanel>
                <Button Content="Browse..."
                        ToolTip.Tip="Select the installed ffprobe executable."
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Command="{Binding BrowseFfprobeCommand}" />
                <TextBox Text="{Binding FfprobePath, Mode=TwoWay}"
                         ToolTip.Tip="Path to the ffprobe executable used to read stream information and duration. Required."
                         PlaceholderText="/usr/bin/ffprobe" />
            </DockPanel>
            <TextBlock Text="{Binding FfprobeStatus}" TextWrapping="Wrap" Classes="secondary" />
        </StackPanel>

        <!-- optional mkvpropedit path -->
        <StackPanel Spacing="4">
            <TextBlock Text="mkvpropedit path (optional)" FontWeight="SemiBold" />
            <DockPanel>
                <Button Content="Browse..."
                        ToolTip.Tip="Select the optional mkvpropedit executable from MKVToolNix."
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Command="{Binding BrowseMkvpropeditCommand}" />
                <TextBox Text="{Binding MkvpropeditPath, Mode=TwoWay}"
                         ToolTip.Tip="Path to mkvpropedit from MKVToolNix. Optional; used to recalculate Matroska track statistics."
                         PlaceholderText="Auto-detect from PATH" />
            </DockPanel>
            <TextBlock Text="{Binding MkvpropeditStatus}" TextWrapping="Wrap" Classes="secondary" />
        </StackPanel>

        <TextBlock Text="{Binding EncodingStatus}" TextWrapping="Wrap" Classes="secondary" />
        <TextBlock Text="{Binding ComparisonStatus}" TextWrapping="Wrap" Classes="secondary" />
        <TextBlock Text="{Binding VlcStatus}" TextWrapping="Wrap" Classes="secondary" />
        <TextBlock Text="Install FFmpeg 9 with shared libraries for comparison playback. On Windows, choose a shared build matching the app architecture; on macOS or Linux, use a package that includes the matching libraries. Install VLC separately for the main-window preview. Restart FFApp after changing shared libraries or installing VLC."
                   TextWrapping="Wrap" Classes="secondary" />

        <!-- Status -->
        <TextBlock Text="{Binding StatusText}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ValidationWarningBrush}"
                   IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Validate button -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
        <Button Content="Check again" Command="{Binding CheckAgainCommand}" />
        <Button Content="Validate and save"
                ToolTip.Tip="Check the executable paths and save the dependency configuration."
                HorizontalAlignment="Center"
                Classes="accent"
                Command="{Binding ValidateAndSaveCommand}" />
        </StackPanel>

        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsValidating}" />

    </StackPanel>
    </ScrollViewer>
</UserControl>
