<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FFApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="FFApp.Views.DependencySetupView"
             x:CompileBindings="True"
             x:DataType="vm:DependencySetupViewModel">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="500"
                Spacing="16">

        <TextBlock Text="FFApp setup"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />

        <TextBlock Text="Configure ffmpeg and ffprobe. mkvpropedit is optional."
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

        <!-- ffmpeg path -->
        <StackPanel Spacing="4">
            <TextBlock Text="ffmpeg path" FontWeight="SemiBold" />
            <DockPanel>
                <Button Content="Browse..."
                        ToolTip.Tip="Select the installed FFmpeg executable."
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Command="{Binding BrowseFfmpegCommand}" />
                <TextBox Text="{Binding FfmpegPath, Mode=TwoWay}"
                         ToolTip.Tip="Path to the FFmpeg executable used to encode media. Required. Use Browse to select your installed executable."
                         PlaceholderText="/usr/bin/ffmpeg" />
            </DockPanel>
        </StackPanel>

        <!-- ffprobe path -->
        <StackPanel Spacing="4">
            <TextBlock Text="ffprobe path" FontWeight="SemiBold" />
            <DockPanel>
                <Button Content="Browse..."
                        ToolTip.Tip="Select the installed ffprobe executable."
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Command="{Binding BrowseFfprobeCommand}" />
                <TextBox Text="{Binding FfprobePath, Mode=TwoWay}"
                         ToolTip.Tip="Path to the ffprobe executable used to read stream information and duration. Required."
                         PlaceholderText="/usr/bin/ffprobe" />
            </DockPanel>
        </StackPanel>

        <!-- optional mkvpropedit path -->
        <StackPanel Spacing="4">
            <TextBlock Text="mkvpropedit path (optional)" FontWeight="SemiBold" />
            <DockPanel>
                <Button Content="Browse..."
                        ToolTip.Tip="Select the optional mkvpropedit executable from MKVToolNix."
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Command="{Binding BrowseMkvpropeditCommand}" />
                <TextBox Text="{Binding MkvpropeditPath, Mode=TwoWay}"
                         ToolTip.Tip="Path to mkvpropedit from MKVToolNix. Optional; used to recalculate Matroska track statistics."
                         PlaceholderText="Auto-detect from PATH" />
            </DockPanel>
        </StackPanel>

        <!-- Status -->
        <TextBlock Text="{Binding StatusText}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ValidationWarningBrush}"
                   IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Validate button -->
        <Button Content="Validate and save"
                ToolTip.Tip="Check the executable paths and save the dependency configuration."
                HorizontalAlignment="Center"
                Classes="accent"
                Command="{Binding ValidateAndSaveCommand}" />

        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsValidating}" />

    </StackPanel>
</UserControl>
