<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FFApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="600"
             x:Class="FFApp.Views.DependencySetupView"
             x:CompileBindings="True"
             x:DataType="vm:DependencySetupViewModel">

    <UserControl.Styles>
        <Style Selector="PathIcon.status">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,2,8,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="PathIcon.status.ok">
            <Setter Property="Data" Value="{StaticResource IconCheckCircle}" />
            <Setter Property="Foreground" Value="{DynamicResource ValidationOkBrush}" />
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="PathIcon.status.warning">
            <Setter Property="Data" Value="{StaticResource IconAlertCircle}" />
            <Setter Property="Foreground" Value="{DynamicResource ValidationWarningBrush}" />
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="PathIcon.status.error">
            <Setter Property="Data" Value="{StaticResource IconCloseCircle}" />
            <Setter Property="Foreground" Value="{DynamicResource ValidationErrorBrush}" />
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="SelectableTextBlock.status-detail">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="SelectableTextBlock.status-detail.error">
            <Setter Property="Foreground" Value="{DynamicResource ValidationErrorBrush}" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- One status line: icon, optional bold title, detail text. -->
        <DataTemplate DataType="vm:ComponentStatus">
            <DockPanel>
                <PathIcon DockPanel.Dock="Left" Classes="status"
                          Classes.ok="{Binding IsOk}"
                          Classes.warning="{Binding IsWarning}"
                          Classes.error="{Binding IsError}" />
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" IsVisible="{Binding HasTitle}" />
                    <SelectableTextBlock Text="{Binding Detail}" Classes="status-detail" Classes.error="{Binding IsError}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel HorizontalAlignment="Stretch" MaxWidth="660" Margin="24" Spacing="10">

        <TextBlock Text="Tools and components" FontSize="24" FontWeight="Bold" />
        <TextBlock Text="FFApp needs FFmpeg and ffprobe 9 or newer. Leave a path empty to find the tool automatically."
                   TextWrapping="Wrap" Classes="secondary" />

        <!-- Required tools -->
        <TextBlock Text="Required" Classes="section" />

        <StackPanel Spacing="4">
            <TextBlock Text="FFmpeg" FontWeight="SemiBold" />
            <DockPanel>
                <Button Content="Browse..."
                        ToolTip.Tip="Select the installed FFmpeg executable."
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Command="{Binding BrowseFfmpegCommand}" />
                <TextBox Text="{Binding FfmpegPath, Mode=TwoWay}"
                         ToolTip.Tip="Path to the FFmpeg executable used to encode media."
                         PlaceholderText="Find automatically" />
            </DockPanel>
            <ContentControl Content="{Binding FfmpegStatus}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="ffprobe" FontWeight="SemiBold" />
            <DockPanel>
                <Button Content="Browse..."
                        ToolTip.Tip="Select the installed ffprobe executable."
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Command="{Binding BrowseFfprobeCommand}" />
                <TextBox Text="{Binding FfprobePath, Mode=TwoWay}"
                         ToolTip.Tip="Path to the ffprobe executable used to read stream information and duration."
                         PlaceholderText="Find automatically" />
            </DockPanel>
            <ContentControl Content="{Binding FfprobeStatus}" />
        </StackPanel>

        <!-- Optional tools -->
        <TextBlock Text="Optional" Classes="section" />

        <StackPanel Spacing="4">
            <TextBlock Text="mkvpropedit (MKVToolNix)" FontWeight="SemiBold" />
            <DockPanel>
                <Button Content="Browse..."
                        ToolTip.Tip="Select mkvpropedit from MKVToolNix."
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Command="{Binding BrowseMkvpropeditCommand}" />
                <TextBox Text="{Binding MkvpropeditPath, Mode=TwoWay}"
                         ToolTip.Tip="Used to refresh Matroska track statistics after encoding."
                         PlaceholderText="Find automatically" />
            </DockPanel>
            <ContentControl Content="{Binding MkvpropeditStatus}" />
        </StackPanel>

        <!-- Features detected from the tools above -->
        <TextBlock Text="Features" Classes="section" />
        <TextBlock Text="Missing features only disable the settings or windows that need them."
                   TextWrapping="Wrap" Classes="secondary" />
        <ContentControl Content="{Binding EncodersStatus}" />
        <ContentControl Content="{Binding HdrFiltersStatus}" />
        <ContentControl Content="{Binding ComparisonStatus}" />
        <ContentControl Content="{Binding PreviewStatus}" />

        <!-- Overall result -->
        <Border Classes="card" Padding="12,10" Margin="0,8,0,0"
                IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <ContentControl Content="{Binding Summary}" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Check again"
                    ToolTip.Tip="Check the paths without saving them."
                    Command="{Binding CheckAgainCommand}" />
            <Button Content="Save"
                    ToolTip.Tip="Check the paths and save them."
                    Classes="accent"
                    Command="{Binding ValidateAndSaveCommand}" />
        </StackPanel>

        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsValidating}" />

    </StackPanel>
    </ScrollViewer>
</UserControl>
