<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FFApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="300"
             x:Class="FFApp.Views.ExecutionView"
             x:CompileBindings="True"
             x:DataType="vm:ExecutionViewModel">

    <StackPanel Margin="8" Spacing="8">

        <!-- Header: state text + spacer + buttons -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="4">
                <Button Content="Start Job"
                        Classes="accent"
                        Command="{Binding StartJobCommand}"
                        IsEnabled="{Binding CanStart}" />
                <Button Content="Cancel Job"
                        Command="{Binding CancelJobCommand}"
                        IsEnabled="{Binding IsRunning}" />
            </StackPanel>

            <TextBlock Text="{Binding StateText}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- Output path -->
        <TextBlock Text="{Binding OutputPath}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   IsVisible="{Binding OutputPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Progress bar (thin) -->
        <ProgressBar Value="{Binding Percentage}"
                     Minimum="0"
                     Maximum="100"
                     Height="6" />

        <!-- Progress text -->
        <TextBlock Text="{Binding ProgressText}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- ffmpeg Log (expandable) -->
        <Expander Header="ffmpeg Log"
                  IsExpanded="False"
                  Padding="0"
                  MinHeight="0">
            <TextBox Text="{Binding LogText, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                     FontSize="11"
                     MaxHeight="300"
                     BorderThickness="1" />
        </Expander>

    </StackPanel>
</UserControl>
