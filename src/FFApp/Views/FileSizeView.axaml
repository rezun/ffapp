<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:ctrl="using:FFApp.Controls"
             x:Class="FFApp.Views.FileSizeView"
             x:CompileBindings="True"
             x:DataType="vm:FileSizeViewModel">

    <Grid ColumnDefinitions="85,Auto,*">
        <TextBlock Text="Target (MiB)" VerticalAlignment="Center" />
        <ctrl:NumericTextBox Grid.Column="1"
            Classes="numeric-input"
            Text="{Binding TargetSizeMbText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
            Width="120"
            Margin="0,0,12,0" />
        <CheckBox Grid.Column="2"
                  Content="Use 2-pass encode"
                  IsChecked="{Binding TwoPass}"
                  VerticalAlignment="Center" />
    </Grid>
</UserControl>
