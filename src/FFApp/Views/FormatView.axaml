<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:ctrl="using:FFApp.Controls"
             x:Class="FFApp.Views.FormatView"
             x:CompileBindings="True"
             x:DataType="vm:FormatViewModel">

    <StackPanel Spacing="8">
        <!-- Container -->
        <Grid ColumnDefinitions="100,*">
            <TextBlock Text="Container" VerticalAlignment="Center" />
            <ctrl:NoWheelComboBox Grid.Column="1"
                ToolTip.Tip="Choose the output file container. It determines which video, audio and subtitle formats can be stored together."
                ItemsSource="{Binding AvailableContainers}"
                SelectedItem="{Binding SelectedContainer}" />
        </Grid>

        <!-- Video Codec -->
        <Grid ColumnDefinitions="100,*">
            <TextBlock Text="Video codec" VerticalAlignment="Center" />
            <ctrl:NoWheelComboBox Grid.Column="1"
                ToolTip.Tip="Choose how the video is compressed. Codec support varies by container and playback device."
                ItemsSource="{Binding AvailableVideoCodecs}"
                SelectedItem="{Binding SelectedVideoCodec}" />
        </Grid>
    </StackPanel>
</UserControl>
