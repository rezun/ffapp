<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:views="using:FFApp.Views"
             xmlns:conv="clr-namespace:FFApp.Converters"
             x:Class="FFApp.Views.JobListPanelView"
             x:CompileBindings="True"
             x:DataType="vm:JobListPanelViewModel">

    <UserControl.Resources>
        <conv:JobStateToColorConverter x:Key="StateToColor" />
    </UserControl.Resources>

    <DockPanel Margin="4,8,8,8">

        <!-- Header -->
        <TextBlock DockPanel.Dock="Top"
                   Text="Jobs"
                   Classes="panel-header"
                   Margin="8,0,8,4" />

        <!-- Execution controls -->
        <DockPanel DockPanel.Dock="Top" Margin="8,0,8,4">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="accent"
                        Content="Start"
                        Command="{Binding StartCommand}"
                        IsVisible="{Binding !IsRunning}"
                        Padding="12,3" />
                <Button Command="{Binding PauseResumeCommand}"
                        Padding="12,3"
                        IsVisible="{Binding IsRunning}">
                    <Panel>
                        <TextBlock Text="Pause" IsVisible="{Binding !IsPaused}" />
                        <TextBlock Text="Resume" IsVisible="{Binding IsPaused}" />
                    </Panel>
                </Button>
                <Button Content="Stop"
                        Command="{Binding StopCommand}"
                        IsVisible="{Binding IsRunning}"
                        Padding="12,3" />
            </StackPanel>
        </DockPanel>

        <!-- Summary text -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding SummaryText}"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="8,0,8,4" />

        <!-- Job list + splitter + details -->
        <Grid RowDefinitions="*,6,Auto">

            <!-- Job list -->
            <ListBox x:Name="JobList"
                     Grid.Row="0"
                     ItemsSource="{Binding Jobs}"
                     SelectedItem="{Binding SelectedJob}"
                     SelectionMode="Multiple"
                     Background="{DynamicResource SurfaceCardBrush}"
                     MinHeight="60">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:JobItemViewModel">
                        <StackPanel Spacing="2">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding State}"
                                           Foreground="{Binding State, Converter={StaticResource StateToColor}}"
                                           Margin="8,0,0,0" />
                                <TextBlock Text="{Binding DisplayLabel}"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <StackPanel Spacing="2"
                                        IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding ProgressText}"
                                           FontSize="11"
                                           Opacity="0.75" />
                                <ProgressBar Value="{Binding Percentage}"
                                             Minimum="0"
                                             Maximum="100"
                                             Height="4"
                                             Foreground="{DynamicResource SystemAccentColor}"
                                             Opacity="0.9" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Splitter -->
            <GridSplitter Grid.Row="1" Height="6" ResizeDirection="Rows" />

            <!-- Details + cleanup buttons -->
            <DockPanel Grid.Row="2" MinHeight="80">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                            Spacing="4" Margin="0,0,0,4">
                    <Button Content="Remove"
                            Command="{Binding RemoveSelectedCommand}"
                            Padding="6,2"
                            FontSize="11" />
                    <Button Content="Clear Finished"
                            Command="{Binding ClearFinishedCommand}"
                            Padding="6,2"
                            FontSize="11" />
                    <Button Content="Clear All"
                            Command="{Binding ClearAllCommand}"
                            Padding="6,2"
                            FontSize="11" />
                </StackPanel>
                <views:JobItemDetailsView DataContext="{Binding Details}" />
            </DockPanel>

        </Grid>

    </DockPanel>
</UserControl>
