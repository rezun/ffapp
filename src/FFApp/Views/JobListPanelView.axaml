<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:views="using:FFApp.Views"
             xmlns:conv="clr-namespace:FFApp.Converters"
             xmlns:remote="using:FFApp.Remote"
             x:Class="FFApp.Views.JobListPanelView"
             x:CompileBindings="True"
             x:DataType="vm:JobListPanelViewModel">

    <UserControl.Resources>
        <conv:JobStateToColorConverter x:Key="StateToColor" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ListBox#JobList TextBlock.queue-state" x:DataType="vm:JobItemViewModel">
            <Setter Property="Foreground" Value="{Binding State, Converter={StaticResource StateToColor}}" />
        </Style>
        <Style Selector="ToggleButton.segment">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.segment.first">
            <Setter Property="CornerRadius" Value="4,0,0,4" />
        </Style>
        <Style Selector="ToggleButton.segment.last">
            <Setter Property="CornerRadius" Value="0,4,4,0" />
        </Style>
        <Style Selector="Border.target-badge">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.target-badge TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="ListBox#JobList ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <!-- Use the theme's selection text color for every label and the progress fill. -->
        <Style Selector="ListBox#JobList ListBoxItem:selected TextBlock" x:CompileBindings="False">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
        </Style>
        <Style Selector="ListBox#JobList ListBoxItem:selected ProgressBar" x:CompileBindings="False">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
            <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource FindAncestor, AncestorType=ContentPresenter, Tree=Visual}}" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="QueueDetailGrid" RowDefinitions="2*,6,1*" Margin="4,8,8,8">

        <!-- Panel 1: Encode Queue -->
        <Border Grid.Row="0" Classes="card" MinHeight="200">
            <DockPanel>
                <!-- Header + execution controls -->
                <StackPanel DockPanel.Dock="Top" Margin="8,6,8,6" Spacing="6">
                    <TextBlock Text="Encode queue"
                               Classes="card-header" Margin="0"
                               VerticalAlignment="Center" />
                    <!-- Where new jobs run, and for server jobs where their result goes -->
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Classes="sm segment first"
                                          Content="Local"
                                          IsChecked="{Binding IsLocalTarget}"
                                          ToolTip.Tip="Encode new jobs on this computer." />
                            <ToggleButton Classes="sm segment last"
                                          Content="Server"
                                          IsChecked="{Binding IsServerTarget}"
                                          IsEnabled="{Binding IsServerAvailable}"
                                          ToolTip.Tip="{Binding ServerStatusText}"
                                          ToolTip.ShowOnDisabled="True" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Result"
                                   Classes="secondary"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsServerTarget}" />
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding ResultOptions}"
                                  SelectedItem="{Binding SelectedResultOption}"
                                  IsVisible="{Binding IsServerTarget}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="Download the result to this computer, or keep it in a folder on the server.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="remote:ResultOption">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <DockPanel IsVisible="{Binding ServerHintText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Button DockPanel.Dock="Right"
                                Classes="xs"
                                Content="{Binding UpdateAgentLabel}"
                                Command="{Binding UpdateAgentCommand}"
                                IsVisible="{Binding OffersAgentUpdate}"
                                Margin="6,0,0,0" />
                        <TextBlock Classes="caption secondary"
                                   Text="{Binding ServerHintText}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                        <SplitButton Grid.Column="0"
                                     Classes="accent sm"
                                     Content="{Binding AddSelectionLabel}"
                                     Command="{Binding CreateJobFromSelectionCommand}"
                                     ToolTip.Tip="Add the selected source files using the current output settings">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{Binding AddAllLabel}"
                                              Command="{Binding CreateJobsForAllCommand}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <Button Grid.Column="1"
                                ToolTip.Tip="Start encoding the pending jobs in the queue."
                                Classes="accent sm"
                                Content="Start"
                                Command="{Binding StartCommand}"
                                IsVisible="{Binding !IsRunning}" />
                        <Button Grid.Column="1"
                                ToolTip.Tip="Pause the active encoder and queue, or resume from the same position. Keep the app open to resume."
                                Classes="warning sm"
                                Command="{Binding PauseResumeCommand}"
                                IsVisible="{Binding IsRunning}">
                            <Panel>
                                <TextBlock Text="Pause" IsVisible="{Binding !IsPaused}" />
                                <TextBlock Text="Resume" IsVisible="{Binding IsPaused}" />
                            </Panel>
                        </Button>
                        <Button Grid.Column="2"
                                ToolTip.Tip="Stop queue processing and cancel the active encode."
                                Classes="danger sm"
                                Content="Stop"
                                Command="{Binding StopCommand}"
                                IsVisible="{Binding IsRunning}" />
                    </Grid>
                </StackPanel>

                <!-- Summary text -->
                <TextBlock DockPanel.Dock="Top"
                           Classes="secondary"
                           Text="{Binding SummaryText}"
                           IsVisible="{Binding HasJobs}"
                           Margin="8,0,8,4" />

                <!-- Queue-wide time estimate -->
                <TextBlock DockPanel.Dock="Top"
                           Classes="secondary"
                           Text="{Binding QueueEstimateText}"
                           IsVisible="{Binding QueueEstimateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap"
                           Margin="8,0,8,4" />

                <!-- Bottom actions -->
                <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                           ItemSpacing="4" LineSpacing="4" Margin="8,4,8,6"
                           IsVisible="{Binding HasJobs}">
                    <Button Classes="sm"
                            ToolTip.Tip="Remove selected jobs from the queue. Source and output files are kept."
                            Content="Remove"
                            Command="{Binding RemoveSelectedCommand}" />
                    <Button Classes="sm"
                            ToolTip.Tip="Remove finished jobs from the queue. Output files are kept."
                            Content="Remove finished"
                            Command="{Binding ClearFinishedCommand}" />
                    <Button Classes="sm"
                            ToolTip.Tip="Clear the job queue. Source and output files are kept."
                            Content="Remove all"
                            Command="{Binding ClearAllCommand}" />
                </WrapPanel>

                <Grid>
                    <!-- Job list -->
                    <ListBox x:Name="JobList"
                             ItemsSource="{Binding Jobs}"
                             SelectedItem="{Binding SelectedJob}"
                             SelectionMode="Multiple"
                             Background="{DynamicResource SurfaceCardBrush}"
                             MinHeight="60"
                             Margin="4,0,4,0"
                             IsVisible="{Binding HasJobs}">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Pause job"
                                          Command="{Binding PauseJobCommand}"
                                          CommandParameter="{Binding SelectedJob}" />
                                <MenuItem Header="Resume job"
                                          Command="{Binding ResumeJobCommand}"
                                          CommandParameter="{Binding SelectedJob}" />
                                <MenuItem Header="Cancel job"
                                          Command="{Binding CancelJobCommand}"
                                          CommandParameter="{Binding SelectedJob}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:JobItemViewModel">
                                <StackPanel Spacing="2">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Classes="queue-state"
                                                   Text="{Binding State}"
                                                   Margin="8,0,0,0" />
                                        <Border DockPanel.Dock="Left"
                                                Classes="target-badge"
                                                IsVisible="{Binding IsRemote}"
                                                ToolTip.Tip="{Binding TargetBadge}">
                                            <TextBlock Text="Server" />
                                        </Border>
                                        <TextBlock Text="{Binding DisplayLabel}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Classes="caption queue-state"
                                               Text="{Binding Failure.Message}"
                                               IsVisible="{Binding HasFailure}"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Failure.Message}" />
                                    <StackPanel Spacing="2"
                                                IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Classes="caption secondary"
                                                   Text="{Binding ProgressText}" />
                                        <ProgressBar Value="{Binding Percentage}"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Height="4"
                                                     IsVisible="{Binding ShowProgressBar}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty queue guidance -->
                    <StackPanel IsVisible="{Binding !HasJobs}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Margin="20">
                        <TextBlock Text="No jobs in queue."
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyQueueHint}"
                                   Classes="caption secondary"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="240" />
                        <Button Content="{Binding AddSelectionLabel}"
                                ToolTip.Tip="Add selected sources to the queue using the current output settings."
                                Classes="accent sm"
                                Command="{Binding CreateJobFromSelectionCommand}"
                                IsVisible="{Binding HasQueueableSelection}"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Splitter between the two panels -->
        <GridSplitter Grid.Row="1" Height="6" ResizeDirection="Rows" />

        <!-- A single resizable inspector for the selected job. -->
        <Border Grid.Row="2" Classes="card" MinHeight="140">
            <views:JobItemDetailsView DataContext="{Binding Details}" />
        </Border>

    </Grid>
</UserControl>
