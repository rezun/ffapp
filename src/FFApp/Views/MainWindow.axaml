<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FFApp.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="FFApp.Views.MainWindow"
        x:CompileBindings="True"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1440" Height="900"
        MinWidth="800" MinHeight="600"
        DragDrop.AllowDrop="True">

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="View">
                <NativeMenu>
                    <NativeMenuItem Header="System"
                                    ToggleType="Radio" IsChecked="True"
                                    Click="OnThemeSystem" />
                    <NativeMenuItem Header="Dark"
                                    ToggleType="Radio"
                                    Click="OnThemeDark" />
                    <NativeMenuItem Header="Light"
                                    ToggleType="Radio"
                                    Click="OnThemeLight" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Info">
                <NativeMenu>
                    <NativeMenuItem Header="FFApp"
                                    IsEnabled="False" />
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <DockPanel>
        <NativeMenuBar DockPanel.Dock="Top" />
        <Panel>
            <ContentControl Content="{Binding CurrentView}" />
            <Border IsVisible="{Binding CurrentView, Converter={x:Static ObjectConverters.IsNull}}"
                    Background="{DynamicResource SurfaceBaseBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <ProgressBar IsIndeterminate="True"
                                 Width="200"
                                 HorizontalAlignment="Center" />
                    <TextBlock Text="Checking dependencies…"
                               Classes="secondary"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Panel>
    </DockPanel>

</Window>
