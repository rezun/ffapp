<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FFApp.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="FFApp.Views.MainWindow"
        x:CompileBindings="True"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1440" Height="900"
        MinWidth="800" MinHeight="600"
        DragDrop.AllowDrop="True">

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="Tools">
                <NativeMenu>
                    <NativeMenuItem Header="Open FFRux" Command="{Binding OpenFfruxCommand}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Settings">
                <NativeMenu>
                    <NativeMenuItem Header="Tools and components…" Click="OnToolsAndComponents" />
                    <NativeMenuItem Header="Comparison storage…" Click="OnComparisonStorage" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="View">
                <NativeMenu>
                    <NativeMenuItem Header="System"
                                    ToggleType="Radio" IsChecked="True"
                                    Click="OnThemeSystem" />
                    <NativeMenuItem Header="Dark"
                                    ToggleType="Radio"
                                    Click="OnThemeDark" />
                    <NativeMenuItem Header="Light"
                                    ToggleType="Radio"
                                    Click="OnThemeLight" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Transcoding">
                <NativeMenu>
                    <NativeMenuItem Header="Low CPU priority"
                                    ToggleType="CheckBox"
                                    IsChecked="{Binding UseLowPriorityTranscoding, Mode=OneWay}"
                                    Command="{Binding ToggleLowPriorityTranscodingCommand}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Info">
                <NativeMenu>
                    <NativeMenuItem Header="FFApp"
                                    IsEnabled="False" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="Open logs folder" Click="OnOpenLogsFolder" />
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <DockPanel>
        <NativeMenuBar DockPanel.Dock="Top" />
        <Border DockPanel.Dock="Top" Padding="12,6" Background="{DynamicResource SurfaceBaseBrush}"
                IsVisible="{Binding ComponentNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Tools and components…" Click="OnToolsNoticeClick" Margin="12,0,0,0" />
                <TextBlock Text="{Binding ComponentNotice}" TextWrapping="Wrap" VerticalAlignment="Center" Classes="secondary" />
            </DockPanel>
        </Border>
        <Panel>
            <ContentControl Content="{Binding CurrentView}" />
            <Border IsVisible="{Binding CurrentView, Converter={x:Static ObjectConverters.IsNull}}"
                    Background="{DynamicResource SurfaceBaseBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <ProgressBar IsIndeterminate="True"
                                 Width="200"
                                 HorizontalAlignment="Center" />
                    <TextBlock Text="Checking dependencies…"
                               Classes="secondary"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Panel>
    </DockPanel>

</Window>
