<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FFApp.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="FFApp.Views.MainWindow"
        x:CompileBindings="True"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1440" Height="900"
        MinWidth="800" MinHeight="600"
        DragDrop.AllowDrop="True">

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="Tools">
                <NativeMenu>
                    <NativeMenuItem Header="Open FFRux" Command="{Binding OpenFfruxCommand}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Settings">
                <NativeMenu>
                    <NativeMenuItem Header="Tools and components…" Click="OnToolsAndComponents" />
                    <NativeMenuItem Header="Comparison storage…" Click="OnComparisonStorage" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="View">
                <NativeMenu>
                    <NativeMenuItem Header="System"
                                    ToggleType="Radio" IsChecked="True"
                                    Click="OnThemeSystem" />
                    <NativeMenuItem Header="Dark"
                                    ToggleType="Radio"
                                    Click="OnThemeDark" />
                    <NativeMenuItem Header="Light"
                                    ToggleType="Radio"
                                    Click="OnThemeLight" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Transcoding">
                <NativeMenu>
                    <NativeMenuItem Header="Low CPU priority"
                                    ToggleType="CheckBox"
                                    IsChecked="{Binding UseLowPriorityTranscoding, Mode=OneWay}"
                                    Command="{Binding ToggleLowPriorityTranscodingCommand}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Info">
                <NativeMenu>
                    <NativeMenuItem Header="FFApp"
                                    IsEnabled="False" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="Check for updates…" Command="{Binding Updates.CheckForUpdatesCommand}" />
                    <NativeMenuItem Header="Open logs folder" Click="OnOpenLogsFolder" />
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <DockPanel>
        <NativeMenuBar DockPanel.Dock="Top" />
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="JobList.IsRunning">
                        <Binding.FallbackValue>
                            <x:Boolean>False</x:Boolean>
                        </Binding.FallbackValue>
                    </Binding>
                    <Binding Path="Updates.IsVisible" />
                </MultiBinding>
            </Border.IsVisible>
            <Panel>
                <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding JobList.IsRunning, FallbackValue=False}">
                    <TextBlock Text="{Binding JobList.StatusText}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <ProgressBar Grid.Column="1"
                                 Value="{Binding JobList.StatusPercentage}"
                                 Minimum="0" Maximum="100" Height="4"
                                 VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding JobList.StatusPercentage, StringFormat={}{0:F0}%}"
                               VerticalAlignment="Center"
                               MinWidth="36" TextAlignment="Right" Margin="8,0,0,0" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="28"
                      IsVisible="{Binding Updates.IsVisible}">
                    <TextBlock Text="{Binding Updates.StatusText}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <ProgressBar Grid.Column="1"
                                 IsVisible="{Binding Updates.IsBusy}"
                                 IsIndeterminate="{Binding !Updates.IsDownloading}"
                                 Value="{Binding Updates.DownloadPercentage, TargetNullValue=0}"
                                 Minimum="0" Maximum="100" Height="4"
                                 VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               IsVisible="{Binding Updates.IsDownloading}"
                               Text="{Binding Updates.DownloadPercentage, StringFormat={}{0}%}"
                               VerticalAlignment="Center"
                               MinWidth="36" TextAlignment="Right" Margin="8,0,0,0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding !Updates.IsBusy}">
                        <Button Classes="accent sm" Content="Restart and update" Command="{Binding Updates.RestartNowCommand}"
                                IsVisible="{Binding Updates.CanRestart}" />
                        <Button Classes="sm" Content="Open download page" Command="{Binding Updates.OpenDownloadsCommand}"
                                IsVisible="{Binding Updates.CanOpenDownloads}" />
                        <Button Classes="sm" Content="Dismiss" Command="{Binding Updates.DismissCommand}" />
                    </StackPanel>
                </Grid>
            </Panel>
        </Border>
        <Panel>
            <ContentControl Content="{Binding CurrentView}" />
            <Border IsVisible="{Binding CurrentView, Converter={x:Static ObjectConverters.IsNull}}"
                    Background="{DynamicResource SurfaceBaseBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <ProgressBar IsIndeterminate="True"
                                 Width="200"
                                 HorizontalAlignment="Center" />
                    <TextBlock Text="Checking dependencies…"
                               Classes="secondary"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Panel>
    </DockPanel>

</Window>
