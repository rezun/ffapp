<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FFApp.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="FFApp.Views.MainWindow"
        x:CompileBindings="True"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1440" Height="900"
        MinWidth="800" MinHeight="600"
        DragDrop.AllowDrop="True">

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="Tools">
                <NativeMenu>
                    <NativeMenuItem Header="Open FFRux" Command="{Binding OpenFfruxCommand}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Settings">
                <NativeMenu>
                    <NativeMenuItem Header="Tools and components…" Click="OnToolsAndComponents" />
                    <NativeMenuItem Header="Comparison storage…" Click="OnComparisonStorage" />
                    <NativeMenuItem Header="Server agent…" Click="OnServerAgent" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="View">
                <NativeMenu>
                    <NativeMenuItem Header="System"
                                    ToggleType="Radio" IsChecked="True"
                                    Click="OnThemeSystem" />
                    <NativeMenuItem Header="Dark"
                                    ToggleType="Radio"
                                    Click="OnThemeDark" />
                    <NativeMenuItem Header="Light"
                                    ToggleType="Radio"
                                    Click="OnThemeLight" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Transcoding">
                <NativeMenu>
                    <NativeMenuItem Header="Low CPU priority"
                                    ToggleType="CheckBox"
                                    IsChecked="{Binding UseLowPriorityTranscoding, Mode=OneWay}"
                                    Command="{Binding ToggleLowPriorityTranscodingCommand}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="Info">
                <NativeMenu>
                    <NativeMenuItem Header="FFApp"
                                    IsEnabled="False" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="Check for updates…" Command="{Binding Updates.CheckForUpdatesCommand}" IsEnabled="{Binding !Updates.IsBusy}" />
                    <NativeMenuItem Header="Open logs folder" Click="OnOpenLogsFolder" />
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <DockPanel>
        <NativeMenuBar DockPanel.Dock="Top" />
        <Panel>
            <ContentControl Content="{Binding CurrentView}" />
            <Border IsVisible="{Binding CurrentView, Converter={x:Static ObjectConverters.IsNull}}"
                    Background="{DynamicResource SurfaceBaseBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <ProgressBar IsIndeterminate="True"
                                 Width="200"
                                 HorizontalAlignment="Center" />
                    <TextBlock Text="Checking dependencies…"
                               Classes="secondary"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <!-- Update hint: the update is already downloaded, restarting FFApp installs it. -->
            <Border IsVisible="{Binding Updates.IsVisible}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"
                    Padding="12,6,6,6" CornerRadius="6"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    BoxShadow="0 2 8 0 #40000000">
                <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !Updates.IsBusy}">
                    <TextBlock Text="{Binding Updates.StatusText}" VerticalAlignment="Center" />
                    <Button Classes="accent sm" Content="Restart now" Command="{Binding Updates.RestartNowCommand}"
                            IsVisible="{Binding Updates.CanRestart}" />
                    <Button Classes="sm" Content="Open download page" Command="{Binding Updates.OpenDownloadsCommand}"
                            IsVisible="{Binding Updates.CanOpenDownloads}" />
                    <Button Classes="sm" Content="Later" Command="{Binding Updates.DismissCommand}" />
                </StackPanel>
            </Border>
        </Panel>
    </DockPanel>

</Window>
