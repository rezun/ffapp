<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:models="using:FFApp.Core.Models"
             xmlns:conv="using:FFApp.Converters"
             xmlns:ctrl="using:FFApp.Controls"
             x:Class="FFApp.Views.OutputPathView"
             x:CompileBindings="True"
             x:DataType="vm:OutputPathViewModel">

    <UserControl.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <DataTemplate x:Key="ContainerTemplate" x:DataType="models:OutputContainer">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.Container}}" />
        </DataTemplate>
    </UserControl.Resources>

    <Border Classes="card" Margin="0,0,0,8">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Output"
                       Classes="card-header" />
            <Separator DockPanel.Dock="Top" />
            <StackPanel Spacing="4" Margin="8,4,8,6">

                <!-- Container -->
                <Grid ColumnDefinitions="85,Auto,*">
                    <TextBlock Text="Container" VerticalAlignment="Center" />
                    <ctrl:NoWheelComboBox Grid.Column="1"
                        ToolTip.Tip="Choose the output file container. It determines which video, audio and subtitle formats can be stored together."
                        MinWidth="108"
                        ItemsSource="{Binding AvailableContainers}"
                        SelectedItem="{Binding SelectedContainer}"
                        ItemTemplate="{StaticResource ContainerTemplate}" />
                </Grid>

                <!-- Output location -->
                <Grid ColumnDefinitions="85,Auto,Auto">
                    <TextBlock Text="Save to" VerticalAlignment="Center" />
                    <RadioButton Grid.Column="1" Content="Next to source file" GroupName="OutputLocation"
                                 ToolTip.Tip="Write each encoded file into the same folder as its source file."
                                 IsChecked="{Binding LocationMode,
                                     Converter={StaticResource EnumToBool},
                                     ConverterParameter={x:Static models:OutputLocationMode.SourceFolder}}" />
                    <RadioButton Grid.Column="2" Content="Custom folder" GroupName="OutputLocation"
                                 ToolTip.Tip="Write all encoded files into one folder of your choice."
                                 IsChecked="{Binding LocationMode,
                                     Converter={StaticResource EnumToBool},
                                     ConverterParameter={x:Static models:OutputLocationMode.CustomFolder}}"
                                 Margin="12,0,0,0" />
                </Grid>

                <!-- Custom folder (only in custom folder mode) -->
                <Grid ColumnDefinitions="85,*,Auto"
                      IsVisible="{Binding IsCustomFolder}">
                    <TextBlock Text="Folder" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             ToolTip.Tip="Folder for all encoded files. Until one is chosen, files are written next to their source."
                             Text="{Binding CustomFolder}"
                             PlaceholderText="No folder chosen. Files go next to their source." />
                    <Button Grid.Column="2"
                            ToolTip.Tip="Choose the folder for encoded output files."
                            Content="Browse"
                            Command="{Binding BrowseDirectoryCommand}"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center" />
                </Grid>

                <!-- Resolved path for the selected source -->
                <TextBlock Classes="mono caption secondary"
                           ToolTip.Tip="Output file for the selected source. Each source gets its own name; a number is added if the file already exists."
                           Text="{Binding ResolvedPath}"
                           TextWrapping="Wrap"
                           Margin="85,0,0,0"
                           IsVisible="{Binding ResolvedPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            </StackPanel>
        </DockPanel>
    </Border>

</UserControl>
