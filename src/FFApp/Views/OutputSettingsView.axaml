<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:views="using:FFApp.Views"
             xmlns:ctrl="using:FFApp.Controls"
             xmlns:models="using:FFApp.Core.Models"
             xmlns:conv="using:FFApp.Converters"
             xmlns:qvm="using:FFApp.ViewModels.Quality"
             xmlns:sys="using:System"
             x:Class="FFApp.Views.OutputSettingsView"
             x:CompileBindings="True"
             x:DataType="vm:OutputSettingsViewModel">

    <UserControl.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <!-- ItemTemplates for enum display -->
        <DataTemplate x:Key="VideoCodecTemplate" x:DataType="models:VideoCodec">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.VideoCodec}}" />
        </DataTemplate>
        <DataTemplate x:Key="ResolutionTemplate" x:DataType="models:ResolutionPreset">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.Resolution}}" />
        </DataTemplate>
        <DataTemplate x:Key="FrameRateTemplate" x:DataType="models:FrameRatePreset">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.FrameRate}}" />
        </DataTemplate>
        <DataTemplate x:Key="ColorMetadataModeTemplate" x:DataType="models:ColorMetadataMode">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.ColorMetadataMode}}" />
        </DataTemplate>
        <DataTemplate x:Key="ColorRangeTemplate" x:DataType="x:String">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.ColorRange}}" />
        </DataTemplate>
        <DataTemplate x:Key="ToneMapAlgorithmTemplate" x:DataType="models:ToneMapAlgorithm">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.ToneMapAlgorithm}}" />
        </DataTemplate>
        <DataTemplate x:Key="ToneMapEngineTemplate" x:DataType="models:ToneMapEngine">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.ToneMapEngine}}" />
        </DataTemplate>
        <DataTemplate x:Key="LibplaceboToneMapAlgorithmTemplate" x:DataType="models:LibplaceboToneMapAlgorithm">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.LibplaceboToneMapAlgorithm}}" />
        </DataTemplate>
        <DataTemplate x:Key="GamutModeTemplate" x:DataType="models:GamutMode">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.GamutMode}}" />
        </DataTemplate>
        <DataTemplate x:Key="KeyframeUnitTemplate" x:DataType="models:KeyframeUnit">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.KeyframeUnitLabel}}" />
        </DataTemplate>
        <DataTemplate x:Key="Av1TuneTemplate" x:DataType="sys:Int32">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.Av1Tune}}" />
        </DataTemplate>
        <DataTemplate x:Key="Av1ScmTemplate" x:DataType="sys:Int32">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.Av1Scm}}" />
        </DataTemplate>
        <DataTemplate x:Key="Av1VarianceBoostStrengthTemplate" x:DataType="sys:Int32">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.Av1VarianceBoostStrength}}" />
        </DataTemplate>
        <DataTemplate x:Key="Av1VarianceOctileTemplate" x:DataType="sys:Int32">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.Av1VarianceOctile}}" />
        </DataTemplate>
        <DataTemplate x:Key="Av1FilmGrainTemplate" x:DataType="sys:Int32">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.Av1FilmGrain}}" />
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.DataTemplates>
        <!-- Per-codec tuning panels, auto-selected by Active VM type -->
        <DataTemplate DataType="qvm:H26xQualitySettingsViewModel">
            <Border Classes="nested-card" Margin="0,4,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="H.264 / H.265 Encoder Tuning"
                               Classes="nested-card-header" />
                    <Separator DockPanel.Dock="Top" />
                    <StackPanel Spacing="4" Margin="6,4,6,6">
                        <Grid ColumnDefinitions="80,Auto,16,55,Auto,*">
                            <TextBlock Text="Preset" VerticalAlignment="Center" />
                            <ctrl:NoWheelComboBox Grid.Column="1"
                                ToolTip.Tip="Trade encoding time for compression efficiency. Slower presets usually produce smaller files at similar visual quality."
                                MinWidth="92"
                                ItemsSource="{Binding AvailablePresets}"
                                SelectedItem="{Binding Preset}" />
                            <TextBlock Grid.Column="3" Text="Profile" VerticalAlignment="Center" />
                            <ctrl:NoWheelComboBox Grid.Column="4"
                                ToolTip.Tip="Choose the codec feature set required by the playback device. More restrictive profiles may limit compression or bit depth."
                                MinWidth="92"
                                ItemsSource="{Binding AvailableProfiles}"
                                SelectedItem="{Binding Profile}" />
                        </Grid>
                        <Grid ColumnDefinitions="80,*">
                            <TextBlock Text="Additional" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     ToolTip.Tip="Extra encoder options as colon-separated key=value pairs. Passed directly to the selected encoder; supported keys depend on its version."
                                     Text="{Binding AdditionalOptions}"
                                     PlaceholderText="{Binding AdditionalOptionsPlaceholder}" />
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="qvm:Av1QualitySettingsViewModel">
            <Border Classes="nested-card" Margin="0,4,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="AV1 Encoder Tuning"
                               Classes="nested-card-header" />
                    <Separator DockPanel.Dock="Top" />
                    <StackPanel Spacing="4" Margin="6,4,6,6">
                        <Grid ColumnDefinitions="112,*,Auto">
                            <TextBlock Text="Preset" VerticalAlignment="Center" />
                            <Slider Grid.Column="1"
                                    ToolTip.Tip="AV1 speed preset: lower numbers encode more slowly with better compression; higher numbers are faster. Compare results at the same CRF."
                                    Value="{Binding Preset}"
                                    Minimum="0" Maximum="13"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    TickPlacement="BottomRight" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       MinWidth="20" TextAlignment="Right" Margin="8,0,0,0">
                                <Run Text="{Binding Preset}" />
                            </TextBlock>
                        </Grid>
                        <Grid ColumnDefinitions="112,Auto,8,Auto,*">
                            <TextBlock Text="Max Bitrate" VerticalAlignment="Center" />
                            <ctrl:NumericTextBox Grid.Column="1"
                                     ToolTip.Tip="Limit AV1 video bitrate in quality (CRF) mode, in kbps. Leave empty for no cap. A tight cap may reduce quality in complex scenes."
                                     Classes="numeric-input"
                                     MinWidth="120"
                                     PlaceholderText="Off"
                                     Text="{Binding MaxBitrateKbpsText}" />
                            <TextBlock Grid.Column="3" Text="kbps" VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            <TextBlock Grid.Column="4" Classes="secondary"
                                       Text="caps CRF (empty = uncapped)"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                        <Grid ColumnDefinitions="112,Auto,16,Auto,Auto,*">
                            <TextBlock Text="Tune" VerticalAlignment="Center" />
                            <ctrl:NoWheelComboBox Grid.Column="1"
                                ToolTip.Tip="Choose the optimization goal: VQ for perceived video quality; PSNR and SSIM for objective metrics; IQ for image quality; MS-SSIM for multi-scale similarity."
                                MinWidth="120"
                                ItemsSource="{Binding AvailableTunes}"
                                SelectedItem="{Binding Tune}"
                                ItemTemplate="{StaticResource Av1TuneTemplate}" />
                            <TextBlock Grid.Column="3" Text="SCM" VerticalAlignment="Center" />
                            <ctrl:NoWheelComboBox Grid.Column="4"
                                ToolTip.Tip="Screen-content tools help with text, graphics and repeated patterns. Adaptive modes detect suitable areas; AA mode also accounts for anti-aliased edges."
                                MinWidth="160" Margin="8,0,0,0"
                                ItemsSource="{Binding AvailableScm}"
                                SelectedItem="{Binding Scm}"
                                ItemTemplate="{StaticResource Av1ScmTemplate}" />
                        </Grid>
                        <Grid ColumnDefinitions="112,Auto,16,Auto,16,Auto,*">
                            <CheckBox Grid.Column="1"
                                      ToolTip.Tip="Add overlay frames alongside temporally filtered reference frames. This can preserve detail and improve visual quality, with extra encoding work."
                                      Content="Overlays"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding EnableOverlaysChecked}" />
                            <CheckBox x:Name="VarianceBoostEnabledCheckBox" Grid.Column="3"
                                      ToolTip.Tip="Allocate more quality to low-contrast areas to preserve subtle textures. This can increase bitrate in quality mode."
                                      Content="Variance Boost"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding EnableVarianceBoostChecked}" />
                            <CheckBox x:Name="FilmGrainEnabledCheckBox" Grid.Column="5"
                                      Content="Film Grain"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsFilmGrainEnabled}"
                                      ToolTip.Tip="Enable film grain synthesis and show its settings." />
                        </Grid>
                        <Grid x:Name="VarianceBoostOptionsPanel" ColumnDefinitions="112,Auto,16,Auto,Auto,*"
                              IsVisible="{Binding EnableVarianceBoostChecked}">
                            <TextBlock Text="Boost Strength" VerticalAlignment="Center" />
                            <ctrl:NoWheelComboBox x:Name="VarianceBoostStrengthComboBox" Grid.Column="1"
                                MinWidth="160"
                                ItemsSource="{Binding AvailableVarianceBoostStrengths}"
                                SelectedItem="{Binding VarianceBoostStrength}"
                                ItemTemplate="{StaticResource Av1VarianceBoostStrengthTemplate}"
                                ToolTip.Tip="Variance boost strength: 1 is mild, 4 is aggressive. Default: 2 (gentle)." />
                            <TextBlock Grid.Column="3" Text="Octile" VerticalAlignment="Center" />
                            <ctrl:NoWheelComboBox x:Name="VarianceOctileComboBox" Grid.Column="4"
                                MinWidth="120" Margin="8,0,0,0"
                                ItemsSource="{Binding AvailableVarianceOctiles}"
                                SelectedItem="{Binding VarianceOctile}"
                                ItemTemplate="{StaticResource Av1VarianceOctileTemplate}"
                                ToolTip.Tip="Select the variance octile for 8×8 blocks: 4 is the median, 8 is the maximum. Default: 5." />
                        </Grid>
                        <Grid x:Name="FilmGrainOptionsPanel" ColumnDefinitions="112,Auto,16,Auto,16,Auto,*"
                              IsVisible="{Binding IsFilmGrainEnabled}">
                            <TextBlock Text="Grain Strength" VerticalAlignment="Center" />
                            <ctrl:NoWheelComboBox x:Name="FilmGrainComboBox" Grid.Column="1"
                                MinWidth="64"
                                ItemsSource="{Binding AvailableFilmGrainStrengths}"
                                SelectedItem="{Binding FilmGrain}"
                                ItemTemplate="{StaticResource Av1FilmGrainTemplate}"
                                ToolTip.Tip="1–50 controls denoising used to estimate the grain model, not a grain percentage." />
                            <CheckBox x:Name="FilmGrainDenoiseCheckBox" Grid.Column="3"
                                      Content="Denoise"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding FilmGrainDenoiseChecked}"
                                      ToolTip.Tip="Encode the denoised source and restore modeled grain during playback. May reduce bitrate, but can remove fine detail. Off still allows grain synthesis." />
                            <CheckBox x:Name="AdaptiveFilmGrainCheckBox" Grid.Column="5"
                                      Content="Adaptive"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding AdaptiveFilmGrainChecked}"
                                      ToolTip.Tip="Adapt grain modeling block sizes to the video resolution for more consistent grain and fewer visible patterns." />
                        </Grid>
                        <Grid ColumnDefinitions="112,*">
                            <TextBlock Text="Additional" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     ToolTip.Tip="Extra encoder options as colon-separated key=value pairs. Passed directly to the selected encoder; supported keys depend on its version."
                                     PlaceholderText="e.g. sharpness=1:tf-strength=1"
                                     Text="{Binding AdditionalOptions}" />
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="qvm:VpxQualitySettingsViewModel">
            <Border Classes="nested-card" Margin="0,4,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="VP9 Encoder Tuning"
                               Classes="nested-card-header" />
                    <Separator DockPanel.Dock="Top" />
                    <StackPanel Spacing="4" Margin="6,4,6,6">
                        <Grid ColumnDefinitions="80,*,Auto">
                            <TextBlock Text="CPU Used" VerticalAlignment="Center" />
                            <Slider Grid.Column="1"
                                    ToolTip.Tip="VP9 speed setting: lower values spend more time on compression; higher values encode faster with a quality or file-size tradeoff."
                                    Value="{Binding CpuUsed}"
                                    Minimum="0" Maximum="8"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    TickPlacement="BottomRight" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       MinWidth="20" TextAlignment="Right" Margin="8,0,0,0">
                                <Run Text="{Binding CpuUsed}" />
                            </TextBlock>
                        </Grid>
                        <Grid ColumnDefinitions="80,Auto,16,80,Auto,*">
                            <TextBlock Text="Tile Cols" VerticalAlignment="Center" />
                            <ctrl:NoWheelComboBox Grid.Column="1"
                                ToolTip.Tip="VP9 tile columns, expressed as powers of two: 1 = 2 columns, 2 = 4. More tiles allow parallel work but may reduce compression efficiency. 0 leaves the encoder default."
                                MinWidth="64"
                                ItemsSource="{Binding AvailableTileColumns}"
                                SelectedItem="{Binding TileColumns}" />
                            <TextBlock Grid.Column="3" Text="Tile Rows" VerticalAlignment="Center" />
                            <ctrl:NoWheelComboBox Grid.Column="4"
                                ToolTip.Tip="VP9 tile rows, expressed as powers of two: 1 = 2 rows, 2 = 4. More tiles allow parallel work but may reduce compression efficiency. 0 leaves the encoder default."
                                MinWidth="64"
                                ItemsSource="{Binding AvailableTileRows}"
                                SelectedItem="{Binding TileRows}" />
                        </Grid>
                        <Grid ColumnDefinitions="80,*">
                            <TextBlock Text="Additional" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     ToolTip.Tip="Extra VP9 options as colon-separated key=value pairs, such as lag-in-frames=25:tune-content=screen. Passed to FFmpeg as individual encoder options."
                                     PlaceholderText="e.g. lag-in-frames=25:tune-content=screen"
                                     Text="{Binding AdditionalOptions}" />
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <!-- Single column layout: all cards stacked vertically -->
    <StackPanel Spacing="0">

        <!-- Video -->
        <Border Classes="card" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Video"
                           Classes="card-header" />
                <Separator DockPanel.Dock="Top" />
                <StackPanel Spacing="4" Margin="8,4,8,6">

                    <!-- Video Mode -->
                    <Grid ColumnDefinitions="85,*">
                        <TextBlock Text="Video Mode" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsVideoModeEditable}">
                            <RadioButton Content="Copy" GroupName="VideoMode"
                                ToolTip.Tip="Copy video without re-encoding. Preserves its quality; resolution, frame rate, crop and encoder settings do not apply."
                                IsEnabled="{Binding Format.SourceHasVideo}"
                                IsChecked="{Binding Format.SelectedVideoMode,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter={x:Static models:VideoMode.Copy}}" />
                            <RadioButton Content="Re-encode" GroupName="VideoMode"
                                ToolTip.Tip="Encode the video with the selected codec and settings. Allows resizing, frame-rate conversion, crop and HDR-to-SDR conversion."
                                IsEnabled="{Binding Format.SourceHasVideo}"
                                IsChecked="{Binding Format.SelectedVideoMode,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter={x:Static models:VideoMode.Reencode}}" />
                            <RadioButton Content="Remove" GroupName="VideoMode"
                                ToolTip.Tip="Exclude video streams to create audio-only output."
                                IsChecked="{Binding Format.SelectedVideoMode,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter={x:Static models:VideoMode.Remove}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Copy mode info -->
                    <TextBlock Classes="secondary"
                               Text="Video stream will be copied without re-encoding."
                               Margin="85,0,0,0"
                               IsVisible="{Binding Format.SelectedVideoMode,
                                   Converter={StaticResource EnumToBool},
                                   ConverterParameter={x:Static models:VideoMode.Copy}}" />

                    <!-- Audio-only source info -->
                    <TextBlock Classes="secondary"
                               Text="Source has no video streams."
                               Margin="85,0,0,0"
                               IsVisible="{Binding !Format.SourceHasVideo}" />

                    <!-- Re-encode settings (visible only when re-encoding) -->
                    <StackPanel Spacing="4" IsVisible="{Binding Format.IsVideoReencode}">
                        <Grid ColumnDefinitions="85,Auto,16,Auto,8,Auto,16,Auto,8,Auto,*">
                            <TextBlock Text="Video Codec" VerticalAlignment="Center" />
                            <ctrl:NoWheelComboBox Grid.Column="1"
                                ToolTip.Tip="Choose how the video is compressed. Codec support varies by container and playback device."
                                MinWidth="108"
                                ItemsSource="{Binding Format.AvailableVideoCodecs}"
                                SelectedItem="{Binding Format.SelectedVideoCodec}"
                                ItemTemplate="{StaticResource VideoCodecTemplate}" />
                            <TextBlock Grid.Column="3" Text="Resolution" VerticalAlignment="Center" />
                            <ctrl:NoWheelComboBox Grid.Column="5"
                                ToolTip.Tip="Set the output resolution while preserving aspect ratio. Original skips resizing to a preset; enlarging does not recover missing detail."
                                MinWidth="108"
                                ItemsSource="{Binding AvailableResolutions}"
                                SelectedItem="{Binding SelectedResolution}"
                                ItemTemplate="{StaticResource ResolutionTemplate}" />
                            <TextBlock Grid.Column="7" Text="Frame Rate" VerticalAlignment="Center" />
                            <ctrl:NoWheelComboBox Grid.Column="9"
                                ToolTip.Tip="Set output frames per second. Conversion may duplicate or drop frames. Original avoids requesting a frame-rate conversion."
                                MinWidth="108"
                                ItemsSource="{Binding AvailableFrameRates}"
                                SelectedItem="{Binding SelectedFrameRate}"
                                ItemTemplate="{StaticResource FrameRateTemplate}" />
                        </Grid>

                        <Grid x:Name="ColorMetadataSection" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="85,*" Margin="0,4,0,0">
                            <TextBlock Text="Color" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" ColumnDefinitions="220,Auto,*">
                                <ctrl:NoWheelComboBox x:Name="ColorMetadataModeComboBox" HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding Color.IsEditable}"
                                    ToolTip.Tip="Preserve source color labels by default. BT.709 fallback fills only missing values; use it for known HD SDR sources. Manual corrects labels without converting colors. HDR settings take precedence."
                                    ItemsSource="{Binding Color.AvailableModes}"
                                    SelectedItem="{Binding Color.SelectedMode}"
                                    ItemTemplate="{StaticResource ColorMetadataModeTemplate}" />
                                <ToggleButton x:Name="ColorDetailsToggle" Grid.Column="1" Content="Details" Margin="8,0,0,0"
                                    Padding="8,4" VerticalAlignment="Center"
                                    ToolTip.Tip="Show source and output color values and any assumptions."
                                    IsChecked="{Binding Color.AreDetailsVisible}" />
                                <TextBlock Grid.Column="2" Text="{Binding Color.CompactSummary}" Classes="secondary"
                                    Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                    ToolTip.Tip="{Binding Color.OutputSummary}" />
                            </Grid>
                            <StackPanel x:Name="CustomColorMetadataPanel" Grid.Row="1" Grid.Column="1"
                                IsVisible="{Binding Color.IsCustomVisible}">
                                <WrapPanel Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,12,2">
                                        <TextBlock Text="Primaries" VerticalAlignment="Center" />
                                        <ctrl:NoWheelComboBox x:Name="ColorPrimariesComboBox" Width="115"
                                            ToolTip.Tip="Label the existing color primaries without converting the gamut."
                                            ItemsSource="{Binding Color.AvailablePrimaries}" SelectedItem="{Binding Color.SelectedPrimaries}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,12,2">
                                        <TextBlock Text="Transfer" VerticalAlignment="Center" />
                                        <ctrl:NoWheelComboBox x:Name="ColorTransferComboBox" Width="135"
                                            ToolTip.Tip="Label the existing transfer function without applying gamma correction or tone mapping."
                                            ItemsSource="{Binding Color.AvailableTransfers}" SelectedItem="{Binding Color.SelectedTransfer}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,12,2">
                                        <TextBlock Text="Matrix" VerticalAlignment="Center" />
                                        <ctrl:NoWheelComboBox x:Name="ColorMatrixComboBox" Width="115"
                                            ToolTip.Tip="Label the existing YUV matrix without converting pixel values."
                                            ItemsSource="{Binding Color.AvailableMatrices}" SelectedItem="{Binding Color.SelectedMatrix}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,2">
                                        <TextBlock Text="Range" VerticalAlignment="Center" />
                                        <ctrl:NoWheelComboBox x:Name="ColorRangeComboBox" Width="115"
                                            ToolTip.Tip="Label the existing range as Limited or Full without rescaling levels."
                                            ItemsSource="{Binding Color.AvailableRanges}" SelectedItem="{Binding Color.SelectedRange}"
                                            ItemTemplate="{StaticResource ColorRangeTemplate}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel x:Name="ColorMetadataDetails" Grid.Row="2" Grid.Column="1" Spacing="2" Margin="0,4,0,0"
                                IsVisible="{Binding Color.AreDetailsVisible}">
                                <TextBlock Text="{Binding Color.SourceSummary}" Classes="secondary" TextWrapping="Wrap" />
                                <TextBlock x:Name="ColorOutputSummary" Text="{Binding Color.OutputSummary}" Classes="secondary" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!-- HDR Settings (visible when source is HDR and re-encoding) -->
                        <Border Classes="nested-card" Margin="0,4,0,0"
                                IsVisible="{Binding Hdr.IsHdrModeVisible}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="HDR"
                                           Classes="nested-card-header" />
                                <Separator DockPanel.Dock="Top" />
                                <StackPanel Spacing="4" Margin="6,4,6,6">
                                    <Grid ColumnDefinitions="85,*">
                                        <TextBlock Text="HDR Mode" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <RadioButton Content="Preserve HDR" GroupName="HdrMode"
                                                ToolTip.Tip="Keep HDR color information when encoding with a supported codec. Playback requires a suitable HDR display and player."
                                                IsEnabled="{Binding Hdr.IsPreserveAllowed}"
                                                IsChecked="{Binding Hdr.SelectedHdrMode,
                                                    Converter={StaticResource EnumToBool},
                                                    ConverterParameter={x:Static models:HdrMode.Preserve}}" />
                                            <RadioButton Content="Convert to SDR" GroupName="HdrMode"
                                                ToolTip.Tip="Map HDR brightness and colors to SDR for standard displays. The tone-mapping controls below adjust the conversion."
                                                IsChecked="{Binding Hdr.SelectedHdrMode,
                                                    Converter={StaticResource EnumToBool},
                                                    ConverterParameter={x:Static models:HdrMode.TonemapToSdr}}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Classes="secondary"
                                               Text="{Binding Hdr.HdrModeNote}"
                                               Margin="85,0,0,0"
                                               IsVisible="{Binding Hdr.HdrModeNote,
                                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <StackPanel Spacing="4" IsVisible="{Binding Hdr.IsToneMapSettingsVisible}">
                                        <Grid ColumnDefinitions="85,Auto" IsVisible="{Binding Hdr.IsLibplaceboAvailable}">
                                            <TextBlock Text="Engine" VerticalAlignment="Center" />
                                            <ctrl:NoWheelComboBox Grid.Column="1"
                                                ToolTip.Tip="Choose the HDR-to-SDR processing engine. Standard uses FFmpeg tone mapping; libplacebo requires an FFmpeg build with that filter."
                                                MinWidth="160"
                                                ItemsSource="{Binding Hdr.AvailableEngines}"
                                                SelectedItem="{Binding Hdr.SelectedEngine}"
                                                ItemTemplate="{StaticResource ToneMapEngineTemplate}" />
                                        </Grid>

                                        <!-- Standard engine controls -->
                                        <StackPanel Spacing="4" IsVisible="{Binding Hdr.IsStandardEngineVisible}">
                                            <Grid ColumnDefinitions="85,Auto">
                                                <TextBlock Text="Algorithm" VerticalAlignment="Center" />
                                                <ctrl:NoWheelComboBox Grid.Column="1"
                                                    ToolTip.Tip="Choose how HDR highlights fit into SDR. Hable, Reinhard and Mobius use different curves; Clip can discard detail in bright areas."
                                                    MinWidth="160"
                                                    ItemsSource="{Binding Hdr.AvailableAlgorithms}"
                                                    SelectedItem="{Binding Hdr.SelectedAlgorithm}"
                                                    ItemTemplate="{StaticResource ToneMapAlgorithmTemplate}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="85,*,Auto">
                                                <TextBlock Text="Desat" VerticalAlignment="Center" />
                                                <Slider Grid.Column="1"
                                                        ToolTip.Tip="Brightness threshold for reducing color in very bright highlights. Higher values retain more highlight color; 0 disables desaturation."
                                                        Value="{Binding Hdr.Desaturation}"
                                                        Minimum="0" Maximum="10"
                                                        TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                        VerticalAlignment="Center"
                                                        TickPlacement="BottomRight" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                           MinWidth="30" TextAlignment="Right" Margin="8,0,0,0">
                                                    <Run Text="{Binding Hdr.Desaturation, StringFormat={}{0:F1}}" />
                                                </TextBlock>
                                            </Grid>
                                            <Grid ColumnDefinitions="85,Auto,*">
                                                <TextBlock Text="Peak (nits)" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1"
                                                         ToolTip.Tip="Override the source peak used for HDR-to-SDR mapping. Leave empty to use source metadata or filter defaults."
                                                         MinWidth="80"
                                                         PlaceholderText="Auto"
                                                         Text="{Binding Hdr.PeakNitsText}" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- Libplacebo engine controls -->
                                        <StackPanel Spacing="4" IsVisible="{Binding Hdr.IsLibplaceboEngineVisible}">
                                            <Grid ColumnDefinitions="85,Auto">
                                                <TextBlock Text="Algorithm" VerticalAlignment="Center" />
                                                <ctrl:NoWheelComboBox Grid.Column="1"
                                                    ToolTip.Tip="Choose the HDR-to-SDR tone-mapping curve. Auto lets libplacebo select a curve; Clip may discard bright highlight detail."
                                                    MinWidth="160"
                                                    ItemsSource="{Binding Hdr.AvailableLibplaceboAlgorithms}"
                                                    SelectedItem="{Binding Hdr.SelectedLibplaceboAlgorithm}"
                                                    ItemTemplate="{StaticResource LibplaceboToneMapAlgorithmTemplate}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="85,Auto">
                                                <TextBlock Text="Gamut mode" VerticalAlignment="Center" />
                                                <ctrl:NoWheelComboBox Grid.Column="1"
                                                    ToolTip.Tip="Choose how colors outside the SDR color range are mapped. The modes trade color accuracy against detail and contrast preservation."
                                                    MinWidth="160"
                                                    ItemsSource="{Binding Hdr.AvailableGamutModes}"
                                                    SelectedItem="{Binding Hdr.SelectedGamutMode}"
                                                    ItemTemplate="{StaticResource GamutModeTemplate}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="85,*,Auto">
                                                <TextBlock Text="Saturation" VerticalAlignment="Center" />
                                                <Slider Grid.Column="1"
                                                        ToolTip.Tip="Adjust color intensity: 1 keeps the normal level, 0 removes color, and higher values make colors stronger."
                                                        Value="{Binding Hdr.Saturation}"
                                                        Minimum="0" Maximum="2.0"
                                                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                        VerticalAlignment="Center"
                                                        TickPlacement="BottomRight" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                           MinWidth="30" TextAlignment="Right" Margin="8,0,0,0">
                                                    <Run Text="{Binding Hdr.Saturation, StringFormat={}{0:F2}}" />
                                                </TextBlock>
                                            </Grid>
                                            <Grid ColumnDefinitions="85,*,Auto">
                                                <TextBlock Text="Contrast rec." VerticalAlignment="Center" />
                                                <Slider Grid.Column="1"
                                                        ToolTip.Tip="Restore local contrast and fine detail after tone mapping. 0 disables recovery; strong settings may create halos or ringing."
                                                        Value="{Binding Hdr.ContrastRecovery}"
                                                        Minimum="0" Maximum="1.0"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                        VerticalAlignment="Center"
                                                        TickPlacement="BottomRight" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                           MinWidth="30" TextAlignment="Right" Margin="8,0,0,0">
                                                    <Run Text="{Binding Hdr.ContrastRecovery, StringFormat={}{0:F2}}" />
                                                </TextBlock>
                                            </Grid>
                                            <Grid ColumnDefinitions="85,*">
                                                <CheckBox Grid.Column="1" Content="Peak detection"
                                                          ToolTip.Tip="Analyze frame brightness to adapt tone mapping to the video rather than relying only on its HDR metadata."
                                                          IsChecked="{Binding Hdr.PeakDetect}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="85,Auto,*" IsVisible="{Binding !Hdr.PeakDetect}">
                                                <TextBlock Text="Curve tune" VerticalAlignment="Center" />
                                                <ctrl:NumericTextBox Grid.Column="1"
                                                         ToolTip.Tip="Fine-tune the selected tone-mapping curve. Meaning and useful values depend on the algorithm. Leave empty for its default."
                                                         Classes="numeric-input"
                                                         MinWidth="80"
                                                         PlaceholderText="Auto"
                                                         Text="{Binding Hdr.TonemappingParamText}" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Keyframe Interval (all codecs) -->
                        <Grid ColumnDefinitions="85,Auto,8,Auto,*" Margin="0,4,0,0">
                            <TextBlock Text="Keyframes" VerticalAlignment="Center" />
                            <ctrl:NumericTextBox Grid.Column="1"
                                     ToolTip.Tip="Maximum keyframe interval in the selected unit. Shorter intervals improve seeking; longer ones may compress better. Empty uses the encoder default."
                                     Classes="numeric-input"
                                     MinWidth="72"
                                     PlaceholderText="Auto"
                                     Text="{Binding KeyframeIntervalText}" />
                            <ctrl:NoWheelComboBox Grid.Column="3"
                                ToolTip.Tip="Choose frames or, for AV1, seconds for the keyframe interval."
                                MinWidth="88"
                                ItemsSource="{Binding AvailableKeyframeUnits}"
                                SelectedItem="{Binding SelectedKeyframeUnit}"
                                ItemTemplate="{StaticResource KeyframeUnitTemplate}" />
                            <TextBlock Grid.Column="4" Classes="secondary"
                                       Text="empty = encoder default"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>

                        <!-- Encoding Strategy -->
                        <Grid ColumnDefinitions="85,*" Margin="0,4,0,0">
                            <TextBlock Text="Strategy" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <RadioButton Content="Quality" GroupName="Strategy"
                                    ToolTip.Tip="Target visual quality while letting bitrate and file size vary with the complexity of the video."
                                    IsChecked="{Binding Strategy.SelectedStrategy,
                                        Converter={StaticResource EnumToBool},
                                        ConverterParameter={x:Static models:EncodingStrategy.TargetQuality}}" />
                                <RadioButton Content="File size" GroupName="Strategy"
                                    ToolTip.Tip="Calculate a video bitrate to aim for a total output size, accounting for audio and container overhead."
                                    IsChecked="{Binding Strategy.SelectedStrategy,
                                        Converter={StaticResource EnumToBool},
                                        ConverterParameter={x:Static models:EncodingStrategy.TargetFileSize}}" />
                                <RadioButton Content="Bitrate" GroupName="Strategy"
                                    ToolTip.Tip="Target an average video bitrate. Quality varies with scene complexity; audio adds to the total file size."
                                    IsChecked="{Binding Strategy.SelectedStrategy,
                                        Converter={StaticResource EnumToBool},
                                        ConverterParameter={x:Static models:EncodingStrategy.TargetBitrate}}" />
                            </StackPanel>
                        </Grid>

                        <!-- Strategy-specific controls (resolved via DataTemplate in App.axaml) -->
                        <ContentControl Content="{Binding Strategy.ActiveStrategyViewModel}" />

                        <!-- Per-codec encoder tuning: template selected by Active VM type -->
                        <ContentControl Content="{Binding Strategy.Quality.Active}" />

                    </StackPanel>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Audio -->
        <Border Classes="card" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Audio"
                           Classes="card-header" />
                <Separator DockPanel.Dock="Top" />
                <StackPanel Spacing="4" Margin="8,4,8,6">
                    <views:AudioView DataContext="{Binding Audio}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Streams -->
        <Border Classes="card" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Streams"
                           Classes="card-header" />
                <Separator DockPanel.Dock="Top" />
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="8,4,8,6">
                    <CheckBox Content="Remove image streams"
                              ToolTip.Tip="Exclude attached images such as cover art. When unchecked, images are copied unchanged where supported by the output container."
                              IsChecked="{Binding StreamHandling.RemoveImages}" />
                    <CheckBox Content="Remove subtitle streams"
                              ToolTip.Tip="Exclude all subtitle streams. When unchecked, supported subtitles are copied or converted as needed for the output container."
                              IsChecked="{Binding StreamHandling.RemoveSubtitles}" />
                    <CheckBox Content="Remove data streams"
                              ToolTip.Tip="Exclude data streams such as timecode or auxiliary tracks. Only compatible containers can preserve these streams."
                              IsChecked="{Binding StreamHandling.RemoveData}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Post-processing -->
        <Border Classes="card" Margin="0,0,0,8"
                IsVisible="{Binding IsMatroskaPostProcessingVisible}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Post-processing"
                           Classes="card-header" />
                <Separator DockPanel.Dock="Top" />
                <StackPanel Spacing="4" Margin="8,4,8,6">
                    <CheckBox Content="Recalculate Matroska track statistics"
                              ToolTip.Tip="Update Matroska track statistics, such as bitrate and duration, after encoding. Requires mkvpropedit and applies to Matroska output."
                              IsChecked="{Binding RecalculateMatroskaStatistics}"
                              IsEnabled="{Binding IsMatroskaPostProcessingAvailable}" />
                    <TextBlock Classes="secondary"
                               Text="Requires mkvpropedit from MKVToolNix. Rewrites BPS, duration, frame and byte statistics after encoding."
                               TextWrapping="Wrap"
                               IsVisible="{Binding !IsMatroskaPostProcessingAvailable}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Validation (normal card, warning left border only when issues exist) -->
        <Border Classes="card" Margin="0,0,0,8"
                Classes.warning="{Binding HasValidationIssues}">
            <Border.Styles>
                <Style Selector="Border.warning">
                    <Setter Property="BorderThickness" Value="3,1,1,1" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationWarningBrush}" />
                </Style>
            </Border.Styles>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Validation"
                           Classes="card-header" />
                <Separator DockPanel.Dock="Top" />
                <StackPanel Margin="8,4,8,6" Spacing="4">
                    <TextBlock Text="{Binding ValidationText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ValidationWarningBrush}"
                               IsVisible="{Binding HasValidationIssues}" />
                    <TextBlock Classes="secondary"
                               Text="No validation issues."
                               TextWrapping="Wrap"
                               IsVisible="{Binding !HasValidationIssues}" />
                </StackPanel>
            </DockPanel>
        </Border>

    </StackPanel>
</UserControl>
