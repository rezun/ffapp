<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:views="using:FFApp.Views"
             xmlns:ctrl="using:FFApp.Controls"
             xmlns:models="using:FFApp.Core.Models"
             xmlns:conv="using:FFApp.Converters"
             xmlns:sys="using:System"
             x:Class="FFApp.Views.OutputSettingsView"
             x:CompileBindings="True"
             x:DataType="vm:OutputSettingsViewModel">

    <UserControl.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <!-- ItemTemplates for enum display -->
        <DataTemplate x:Key="VideoCodecTemplate" x:DataType="models:VideoCodec">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.VideoCodec}}" />
        </DataTemplate>
        <DataTemplate x:Key="ResolutionTemplate" x:DataType="models:ResolutionPreset">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.Resolution}}" />
        </DataTemplate>
        <DataTemplate x:Key="FrameRateTemplate" x:DataType="models:FrameRatePreset">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.FrameRate}}" />
        </DataTemplate>
        <DataTemplate x:Key="ToneMapAlgorithmTemplate" x:DataType="models:ToneMapAlgorithm">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.ToneMapAlgorithm}}" />
        </DataTemplate>
        <DataTemplate x:Key="KeyframeUnitTemplate" x:DataType="models:KeyframeUnit">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.KeyframeUnitLabel}}" />
        </DataTemplate>
        <DataTemplate x:Key="Av1TuneTemplate" x:DataType="sys:Int32">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.Av1Tune}}" />
        </DataTemplate>
        <DataTemplate x:Key="Av1ScmTemplate" x:DataType="sys:Int32">
            <TextBlock Text="{Binding Converter={x:Static conv:EnumLabelConverters.Av1Scm}}" />
        </DataTemplate>
    </UserControl.Resources>

    <!-- Single column layout: all cards stacked vertically -->
    <StackPanel Spacing="0">

        <!-- Video -->
        <Border Classes="card" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Video"
                           Classes="card-header" />
                <Separator DockPanel.Dock="Top" />
                <StackPanel Spacing="4" Margin="8,4,8,6">

                    <!-- Video Mode -->
                    <Grid ColumnDefinitions="85,*">
                        <TextBlock Text="Video Mode" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <RadioButton Content="Copy" GroupName="VideoMode"
                                IsEnabled="{Binding Format.SourceHasVideo}"
                                IsChecked="{Binding Format.SelectedVideoMode,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter={x:Static models:VideoMode.Copy}}" />
                            <RadioButton Content="Re-encode" GroupName="VideoMode"
                                IsEnabled="{Binding Format.SourceHasVideo}"
                                IsChecked="{Binding Format.SelectedVideoMode,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter={x:Static models:VideoMode.Reencode}}" />
                            <RadioButton Content="Remove" GroupName="VideoMode"
                                IsChecked="{Binding Format.SelectedVideoMode,
                                    Converter={StaticResource EnumToBool},
                                    ConverterParameter={x:Static models:VideoMode.Remove}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Copy mode info -->
                    <TextBlock Classes="secondary"
                               Text="Video stream will be copied without re-encoding."
                               Margin="85,0,0,0"
                               IsVisible="{Binding Format.SelectedVideoMode,
                                   Converter={StaticResource EnumToBool},
                                   ConverterParameter={x:Static models:VideoMode.Copy}}" />

                    <!-- Audio-only source info -->
                    <TextBlock Classes="secondary"
                               Text="Source has no video streams."
                               Margin="85,0,0,0"
                               IsVisible="{Binding !Format.SourceHasVideo}" />

                    <!-- Re-encode settings (visible only when re-encoding) -->
                    <StackPanel Spacing="4" IsVisible="{Binding Format.IsVideoReencode}">
                        <Grid ColumnDefinitions="85,Auto,16,Auto,8,Auto,16,Auto,8,Auto,*">
                            <TextBlock Text="Video Codec" VerticalAlignment="Center" />
                            <ctrl:NoWheelComboBox Grid.Column="1"
                                MinWidth="108"
                                ItemsSource="{Binding Format.AvailableVideoCodecs}"
                                SelectedItem="{Binding Format.SelectedVideoCodec}"
                                ItemTemplate="{StaticResource VideoCodecTemplate}" />
                            <TextBlock Grid.Column="3" Text="Resolution" VerticalAlignment="Center" />
                            <ctrl:NoWheelComboBox Grid.Column="5"
                                MinWidth="108"
                                ItemsSource="{Binding AvailableResolutions}"
                                SelectedItem="{Binding SelectedResolution}"
                                ItemTemplate="{StaticResource ResolutionTemplate}" />
                            <TextBlock Grid.Column="7" Text="Frame Rate" VerticalAlignment="Center" />
                            <ctrl:NoWheelComboBox Grid.Column="9"
                                MinWidth="108"
                                ItemsSource="{Binding AvailableFrameRates}"
                                SelectedItem="{Binding SelectedFrameRate}"
                                ItemTemplate="{StaticResource FrameRateTemplate}" />
                        </Grid>

                        <!-- HDR Settings (visible when source is HDR and re-encoding) -->
                        <Border Classes="nested-card" Margin="0,4,0,0"
                                IsVisible="{Binding Hdr.IsHdrModeVisible}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="HDR"
                                           Classes="nested-card-header" />
                                <Separator DockPanel.Dock="Top" />
                                <StackPanel Spacing="4" Margin="6,4,6,6">
                                    <Grid ColumnDefinitions="85,*">
                                        <TextBlock Text="HDR Mode" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <RadioButton Content="Preserve HDR" GroupName="HdrMode"
                                                IsEnabled="{Binding Hdr.IsPreserveAllowed}"
                                                IsChecked="{Binding Hdr.SelectedHdrMode,
                                                    Converter={StaticResource EnumToBool},
                                                    ConverterParameter={x:Static models:HdrMode.Preserve}}" />
                                            <RadioButton Content="Convert to SDR" GroupName="HdrMode"
                                                IsChecked="{Binding Hdr.SelectedHdrMode,
                                                    Converter={StaticResource EnumToBool},
                                                    ConverterParameter={x:Static models:HdrMode.TonemapToSdr}}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Classes="secondary"
                                               Text="{Binding Hdr.HdrModeNote}"
                                               Margin="85,0,0,0"
                                               IsVisible="{Binding Hdr.HdrModeNote,
                                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <StackPanel Spacing="4" IsVisible="{Binding Hdr.IsToneMapSettingsVisible}">
                                        <Grid ColumnDefinitions="85,Auto">
                                            <TextBlock Text="Algorithm" VerticalAlignment="Center" />
                                            <ctrl:NoWheelComboBox Grid.Column="1"
                                                MinWidth="160"
                                                ItemsSource="{Binding Hdr.AvailableAlgorithms}"
                                                SelectedItem="{Binding Hdr.SelectedAlgorithm}"
                                                ItemTemplate="{StaticResource ToneMapAlgorithmTemplate}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="85,*,Auto">
                                            <TextBlock Text="Desat" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1"
                                                    Value="{Binding Hdr.Desaturation}"
                                                    Minimum="0" Maximum="10"
                                                    TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"
                                                    TickPlacement="BottomRight" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                       MinWidth="30" TextAlignment="Right" Margin="8,0,0,0">
                                                <Run Text="{Binding Hdr.Desaturation, StringFormat={}{0:F1}}" />
                                            </TextBlock>
                                        </Grid>
                                        <Grid ColumnDefinitions="85,Auto,*">
                                            <TextBlock Text="Peak (nits)" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     MinWidth="80"
                                                     PlaceholderText="Auto"
                                                     Text="{Binding Hdr.PeakNitsText}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Keyframe Interval (all codecs) -->
                        <Grid ColumnDefinitions="85,Auto,8,Auto,*" Margin="0,4,0,0">
                            <TextBlock Text="Keyframes" VerticalAlignment="Center" />
                            <ctrl:NumericTextBox Grid.Column="1"
                                     Classes="numeric-input"
                                     MinWidth="72"
                                     PlaceholderText="Auto"
                                     Text="{Binding KeyframeIntervalText}" />
                            <ctrl:NoWheelComboBox Grid.Column="3"
                                MinWidth="88"
                                ItemsSource="{Binding AvailableKeyframeUnits}"
                                SelectedItem="{Binding SelectedKeyframeUnit}"
                                ItemTemplate="{StaticResource KeyframeUnitTemplate}" />
                            <TextBlock Grid.Column="4" Classes="secondary"
                                       Text="empty = encoder default"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>

                        <!-- Encoding Strategy -->
                        <Grid ColumnDefinitions="85,*" Margin="0,4,0,0">
                            <TextBlock Text="Strategy" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <RadioButton Content="Quality" GroupName="Strategy"
                                    IsChecked="{Binding Strategy.SelectedStrategy,
                                        Converter={StaticResource EnumToBool},
                                        ConverterParameter={x:Static models:EncodingStrategy.TargetQuality}}" />
                                <RadioButton Content="File size" GroupName="Strategy"
                                    IsChecked="{Binding Strategy.SelectedStrategy,
                                        Converter={StaticResource EnumToBool},
                                        ConverterParameter={x:Static models:EncodingStrategy.TargetFileSize}}" />
                                <RadioButton Content="Bitrate" GroupName="Strategy"
                                    IsChecked="{Binding Strategy.SelectedStrategy,
                                        Converter={StaticResource EnumToBool},
                                        ConverterParameter={x:Static models:EncodingStrategy.TargetBitrate}}" />
                            </StackPanel>
                        </Grid>

                        <!-- Strategy-specific controls (resolved via DataTemplate in App.axaml) -->
                        <ContentControl Content="{Binding Strategy.ActiveStrategyViewModel}" />

                        <!-- H.264/H.265 Encoder Tuning -->
                        <Border Classes="nested-card" Margin="0,4,0,0"
                                IsVisible="{Binding Strategy.Quality.IsH26xCodec}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="H.264 / H.265 Encoder Tuning"
                                           Classes="nested-card-header" />
                                <Separator DockPanel.Dock="Top" />
                                <Grid ColumnDefinitions="55,Auto,16,55,Auto,*"
                                      Margin="6,4,6,6">
                                    <TextBlock Text="Preset" VerticalAlignment="Center" />
                                    <ctrl:NoWheelComboBox Grid.Column="1"
                                        MinWidth="92"
                                        ItemsSource="{Binding Strategy.Quality.AvailablePresets}"
                                        SelectedItem="{Binding Strategy.Quality.H26xPreset}" />
                                    <TextBlock Grid.Column="3" Text="Profile" VerticalAlignment="Center" />
                                    <ctrl:NoWheelComboBox Grid.Column="4"
                                        MinWidth="92"
                                        ItemsSource="{Binding Strategy.Quality.AvailableProfiles}"
                                        SelectedItem="{Binding Strategy.Quality.H26xProfile}" />
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- AV1 Encoder Tuning -->
                        <Border Classes="nested-card" Margin="0,4,0,0"
                                IsVisible="{Binding Strategy.Quality.IsAv1Codec}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="AV1 Encoder Tuning"
                                           Classes="nested-card-header" />
                                <Separator DockPanel.Dock="Top" />
                                <StackPanel Spacing="4" Margin="6,4,6,6">
                                    <Grid ColumnDefinitions="80,*,Auto">
                                        <TextBlock Text="Preset" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1"
                                                Value="{Binding Strategy.Quality.Av1Preset}"
                                                Minimum="0" Maximum="13"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                TickPlacement="BottomRight" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                   MinWidth="20" TextAlignment="Right" Margin="8,0,0,0">
                                            <Run Text="{Binding Strategy.Quality.Av1Preset}" />
                                        </TextBlock>
                                    </Grid>
                                    <Grid ColumnDefinitions="80,Auto,8,Auto,*"
                                          IsVisible="{Binding Strategy.SelectedStrategy,
                                              Converter={StaticResource EnumToBool},
                                              ConverterParameter={x:Static models:EncodingStrategy.TargetQuality}}">
                                        <TextBlock Text="Max Bitrate" VerticalAlignment="Center" />
                                        <ctrl:NumericTextBox Grid.Column="1"
                                                 Classes="numeric-input"
                                                 MinWidth="120"
                                                 PlaceholderText="Off"
                                                 Text="{Binding Strategy.Quality.Av1MaxBitrateKbpsText}" />
                                        <TextBlock Grid.Column="3" Text="kbps" VerticalAlignment="Center"
                                                   Margin="6,0,0,0" />
                                        <TextBlock Grid.Column="4" Classes="secondary"
                                                   Text="caps CRF (empty = uncapped)"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                    <Grid ColumnDefinitions="80,Auto,16,Auto,Auto,*">
                                        <TextBlock Text="Tune" VerticalAlignment="Center" />
                                        <ctrl:NoWheelComboBox Grid.Column="1"
                                            MinWidth="120"
                                            ItemsSource="{Binding Strategy.Quality.AvailableAv1Tunes}"
                                            SelectedItem="{Binding Strategy.Quality.Av1Tune}"
                                            ItemTemplate="{StaticResource Av1TuneTemplate}" />
                                        <TextBlock Grid.Column="3" Text="SCM" VerticalAlignment="Center" />
                                        <ctrl:NoWheelComboBox Grid.Column="4"
                                            MinWidth="160" Margin="8,0,0,0"
                                            ItemsSource="{Binding Strategy.Quality.AvailableAv1Scm}"
                                            SelectedItem="{Binding Strategy.Quality.Av1Scm}"
                                            ItemTemplate="{StaticResource Av1ScmTemplate}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="80,Auto,16,Auto,*">
                                        <CheckBox Grid.Column="1"
                                                  Content="Overlays"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding Strategy.Quality.Av1EnableOverlaysChecked}" />
                                        <CheckBox Grid.Column="3"
                                                  Content="Variance Boost"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding Strategy.Quality.Av1EnableVarianceBoostChecked}" />
                                    </Grid>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- VP9 Encoder Tuning -->
                        <Border Classes="nested-card" Margin="0,4,0,0"
                                IsVisible="{Binding Strategy.Quality.IsVpxCodec}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="VP9 Encoder Tuning"
                                           Classes="nested-card-header" />
                                <Separator DockPanel.Dock="Top" />
                                <StackPanel Spacing="4" Margin="6,4,6,6">
                                    <Grid ColumnDefinitions="80,*,Auto">
                                        <TextBlock Text="CPU Used" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1"
                                                Value="{Binding Strategy.Quality.VpxCpuUsed}"
                                                Minimum="0" Maximum="8"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                TickPlacement="BottomRight" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                   MinWidth="20" TextAlignment="Right" Margin="8,0,0,0">
                                            <Run Text="{Binding Strategy.Quality.VpxCpuUsed}" />
                                        </TextBlock>
                                    </Grid>
                                    <Grid ColumnDefinitions="80,Auto,16,80,Auto,*">
                                        <TextBlock Text="Tile Cols" VerticalAlignment="Center" />
                                        <ctrl:NoWheelComboBox Grid.Column="1"
                                            MinWidth="64"
                                            ItemsSource="{Binding Strategy.Quality.AvailableTileColumns}"
                                            SelectedItem="{Binding Strategy.Quality.VpxTileColumns}" />
                                        <TextBlock Grid.Column="3" Text="Tile Rows" VerticalAlignment="Center" />
                                        <ctrl:NoWheelComboBox Grid.Column="4"
                                            MinWidth="64"
                                            ItemsSource="{Binding Strategy.Quality.AvailableTileRows}"
                                            SelectedItem="{Binding Strategy.Quality.VpxTileRows}" />
                                    </Grid>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Audio -->
        <Border Classes="card" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Audio"
                           Classes="card-header" />
                <Separator DockPanel.Dock="Top" />
                <StackPanel Spacing="4" Margin="8,4,8,6">
                    <views:AudioView DataContext="{Binding Audio}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Streams -->
        <Border Classes="card" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Streams"
                           Classes="card-header" />
                <Separator DockPanel.Dock="Top" />
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="8,4,8,6">
                    <CheckBox Content="Remove subtitle streams"
                              IsChecked="{Binding StreamHandling.RemoveSubtitles}" />
                    <CheckBox Content="Remove data streams"
                              IsChecked="{Binding StreamHandling.RemoveData}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Validation (normal card, warning left border only when issues exist) -->
        <Border Classes="card" Margin="0,0,0,8"
                Classes.warning="{Binding HasValidationIssues}">
            <Border.Styles>
                <Style Selector="Border.warning">
                    <Setter Property="BorderThickness" Value="3,1,1,1" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationWarningBrush}" />
                </Style>
            </Border.Styles>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Validation"
                           Classes="card-header" />
                <Separator DockPanel.Dock="Top" />
                <StackPanel Margin="8,4,8,6" Spacing="4">
                    <TextBlock Text="{Binding ValidationText}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ValidationWarningBrush}"
                               IsVisible="{Binding HasValidationIssues}" />
                    <TextBlock Classes="secondary"
                               Text="No validation issues."
                               TextWrapping="Wrap"
                               IsVisible="{Binding !HasValidationIssues}" />
                </StackPanel>
            </DockPanel>
        </Border>

    </StackPanel>
</UserControl>
