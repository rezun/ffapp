<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:ctrl="using:FFApp.Controls"
             xmlns:models="using:FFApp.Core.Models"
             x:Class="FFApp.Views.PresetBarView"
             x:Name="PresetRoot"
             x:CompileBindings="True"
             x:DataType="vm:PresetViewModel">

    <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Preset" VerticalAlignment="Center"
                   FontWeight="SemiBold" />
        <ctrl:NoWheelComboBox
 ToolTip.Tip="Load saved output settings. Source-specific audio-track selection, trim and crop are handled separately."            ItemsSource="{Binding Presets}"
            SelectedItem="{Binding SelectedPreset}"
            PlaceholderText="(No preset)"
            MinWidth="160">
            <ctrl:NoWheelComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:PresetDefinition">
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ctrl:NoWheelComboBox.ItemTemplate>
            <ctrl:NoWheelComboBox.SelectionBoxItemTemplate>
                <DataTemplate x:DataType="models:PresetDefinition">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="*" FontWeight="Bold"
                                   IsVisible="{Binding #PresetRoot.((vm:PresetViewModel)DataContext).IsPresetDirty, FallbackValue=False}"
                                   ToolTip.Tip="Preset has unsaved changes" />
                    </StackPanel>
                </DataTemplate>
            </ctrl:NoWheelComboBox.SelectionBoxItemTemplate>
        </ctrl:NoWheelComboBox>
        <Button Content="Save as" Command="{Binding SavePresetCommand}"
                ToolTip.Tip="Save current settings as a preset" />
        <Button Content="Revert" Command="{Binding RevertPresetCommand}"
                ToolTip.Tip="Discard changes and restore the preset's saved values" />
        <Button Content="Rename" Command="{Binding RenamePresetCommand}"
                ToolTip.Tip="Rename the selected user preset."
                IsEnabled="{Binding IsUserPresetSelected}" />
        <Button Content="Delete" Command="{Binding DeletePresetCommand}"
                ToolTip.Tip="Delete the selected user preset from the preset list."
                IsEnabled="{Binding IsUserPresetSelected}" />
    </StackPanel>
</UserControl>
