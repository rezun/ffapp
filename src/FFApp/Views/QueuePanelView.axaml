<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:views="using:FFApp.Views"
             xmlns:conv="using:FFApp.Converters"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="500"
             x:Class="FFApp.Views.QueuePanelView"
             x:CompileBindings="True"
             x:DataType="vm:QueuePanelViewModel">

    <UserControl.Resources>
        <conv:JobStateToColorConverter x:Key="StateToColor" />
    </UserControl.Resources>

    <DockPanel Margin="8">

        <!-- Top toolbar: Add Files -->
        <Button DockPanel.Dock="Top"
                Content="Add Files..."
                Command="{Binding AddFilesCommand}"
                Margin="0,0,0,4" />

        <!-- Summary + action bar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right"
                    Content="Cancel"
                    Command="{Binding CancelQueueCommand}"
                    IsVisible="{Binding IsRunning}"
                    Margin="4,0,0,0" />
            <Button DockPanel.Dock="Right"
                    Classes="accent"
                    Content="Start Queue"
                    Command="{Binding StartQueueCommand}"
                    IsVisible="{Binding !IsRunning}" />
            <TextBlock Text="{Binding SummaryText}"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- Cleanup links + details (below the list) -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Clear Finished"
                        Command="{Binding ClearFinishedCommand}" />
                <Button Content="Clear All"
                        Command="{Binding ClearListCommand}" />
            </StackPanel>
            <views:QueueItemDetailsView DataContext="{Binding Details}" />
        </StackPanel>

        <!-- Queue item list -->
        <ListBox x:Name="QueueList"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem}"
                 Background="{DynamicResource SurfaceCardBrush}"
                 MinHeight="120">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:QueueItemViewModel">
                    <StackPanel Spacing="2">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding State}"
                                       Foreground="{Binding State, Converter={StaticResource StateToColor}}"
                                       Margin="8,0,0,0" />
                            <TextBlock Text="{Binding DisplayLabel}"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <DockPanel IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding ProgressText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       Margin="8,0,0,0" />
                            <ProgressBar Value="{Binding Percentage}"
                                         Minimum="0"
                                         Maximum="100"
                                         Height="4"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                         Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                        </DockPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</UserControl>
