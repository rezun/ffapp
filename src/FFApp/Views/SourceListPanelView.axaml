<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             x:Class="FFApp.Views.SourceListPanelView"
             x:DataType="vm:SourceListPanelViewModel"
             x:CompileBindings="True">

    <DockPanel Margin="8,8,4,8">

        <!-- Source Files (header + list + actions in one card) -->
        <Border DockPanel.Dock="Top" Classes="card"
                Margin="0,0,0,8">
            <DockPanel>
                <!-- Header row -->
                <DockPanel DockPanel.Dock="Top" Margin="8,6,8,4">
                    <TextBlock Text="Source Files"
                               Classes="card-header" Margin="0"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="4">
                        <Button Content="Add"
                                Classes="accent sm"
                                Command="{Binding AddFilesCommand}"
                                ToolTip.Tip="Add one or more files" />
                        <Button Content="Add folder"
                                Classes="sm"
                                Command="{Binding AddFolderCommand}"
                                ToolTip.Tip="Add all media files from a folder" />
                    </StackPanel>
                </DockPanel>

                <!-- Bottom actions -->
                <StackPanel DockPanel.Dock="Bottom" Margin="8,4,8,6" Spacing="4">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4">
                        <Button Classes="sm"
                                Content="Remove"
                                Command="{Binding RemoveSelectedCommand}" />
                        <Button Classes="sm"
                                Content="Remove all"
                                Command="{Binding ClearAllCommand}" />
                    </WrapPanel>

                    <TextBlock Classes="caption secondary"
                               Text="{Binding StatusText}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- File list -->
                <ListBox x:Name="SourceList"
                         ItemsSource="{Binding Sources}"
                         SelectedItem="{Binding SelectedSource}"
                         SelectionMode="Multiple"
                         Background="{DynamicResource SurfaceCardBrush}"
                         MinHeight="80"
                         MaxHeight="300"
                         Margin="4,4,4,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SourceFileViewModel">
                            <DockPanel>
                                <ProgressBar DockPanel.Dock="Right"
                                             IsIndeterminate="True"
                                             IsVisible="{Binding IsProbing}"
                                             Width="30"
                                             Height="3"
                                             Margin="4,0,0,0"
                                             VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right"
                                           Classes="caption"
                                           Text="Error"
                                           Foreground="{DynamicResource ValidationErrorBrush}"
                                           IsVisible="{Binding HasError}"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0" />
                                <TextBlock Text="{Binding DisplayLabel}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding SourcePath}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Media Info Summary -->
        <Border Classes="card">
            <DockPanel Margin="8,6,8,8">
                <TextBlock DockPanel.Dock="Top"
                           Text="Media Info"
                           Classes="card-header" Margin="0,0,0,4" />

                <SelectableTextBlock Classes="mono caption"
                         Text="{Binding MediaSummaryText, Mode=OneWay}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding MediaSummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="caption secondary"
                           Text="No source file selected."
                           IsVisible="{Binding MediaSummaryText, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
            </DockPanel>
        </Border>

    </DockPanel>
</UserControl>
