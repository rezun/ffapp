<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             x:Class="FFApp.Views.StreamHandlingView"
             x:CompileBindings="True"
             x:DataType="vm:StreamHandlingViewModel">

    <StackPanel Spacing="4">
        <CheckBox Content="Remove subtitle streams"
                  ToolTip.Tip="Exclude all subtitle streams. When unchecked, supported subtitles are copied or converted as needed for the output container."
                  IsChecked="{Binding RemoveSubtitles}" />
        <CheckBox Content="Remove data streams"
                  ToolTip.Tip="Exclude data streams such as timecode or auxiliary tracks. Only compatible containers can preserve these streams."
                  IsChecked="{Binding RemoveData}" />
    </StackPanel>
</UserControl>
