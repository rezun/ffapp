<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:vlc="using:LibVLCSharp.Avalonia"
             x:Class="FFApp.Views.VideoPreviewView"
             x:CompileBindings="True"
             x:DataType="vm:VideoPreviewViewModel">

    <Border Classes="card" Margin="8,8,8,0">
        <DockPanel>
            <!-- Header: always visible -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="8,6,8,4">
                <TextBlock Text="Preview and Edit"
                           Classes="card-header" Margin="0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Classes="secondary"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
                <Button Grid.Column="2"
                        ToolTip.Tip="Show or hide the source preview and trim/crop controls."
                        Classes="sm"
                        Content="{Binding IsExpanded, Converter={x:Static vm:VideoPreviewViewModel.ExpandCollapseConverter}}"
                        Command="{Binding ToggleExpandedCommand}"
                        IsVisible="{Binding IsAvailable}" />
            </Grid>
            <Separator DockPanel.Dock="Top" IsVisible="{Binding IsExpanded}" />

            <!-- VLC not installed message -->
            <TextBlock IsVisible="{Binding !IsAvailable}"
                       Classes="secondary"
                       Text="Install VLC to enable video preview."
                       Margin="8,6,8,8" />

            <!-- Expandable content (only when VLC is available) -->
            <DockPanel IsVisible="{Binding IsExpanded}">

                <!-- Transport controls docked at bottom -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="0" Margin="8,4,8,6">

                    <!-- Timeline slider -->
                    <Slider x:Name="TimelineSlider"
                            ToolTip.Tip="Seek to a position in the source video preview. This does not change the trim range."
                            Minimum="0" Maximum="1"
                            Value="{Binding Position}"
                            SmallChange="0.001"
                            LargeChange="0.01"
                            Margin="0,-4,0,-4" />

                    <!-- Time display row -->
                    <Grid ColumnDefinitions="*,Auto,*" Margin="0,2,0,0">
                        <TextBlock Grid.Column="0"
                                   Classes="mono caption"
                                   Text="{Binding TimeDisplay}"
                                   VerticalAlignment="Center" />

                        <!-- Transport buttons: centered -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4">
                            <Button Classes="sm"
                                    Content="&#x25C0;&#xFE0E;"
                                    ToolTip.Tip="Step back one frame"
                                    Command="{Binding StepBackwardCommand}"
                                    IsEnabled="{Binding HasMedia}" />
                            <Button Classes="sm"
                                    Content="{Binding PlayPauseLabel}"
                                    ToolTip.Tip="Play / Pause"
                                    Command="{Binding PlayPauseCommand}"
                                    MinWidth="36"
                                    HorizontalContentAlignment="Center"
                                    IsEnabled="{Binding HasMedia}" />
                            <Button Classes="sm"
                                    Content="&#x25B6;&#xFE0E;"
                                    ToolTip.Tip="Step forward one frame"
                                    Command="{Binding StepForwardCommand}"
                                    IsEnabled="{Binding HasMedia}" />
                        </StackPanel>

                        <!-- Spacer to balance the grid -->
                        <Panel Grid.Column="2" />
                    </Grid>

                    <!-- Trim and Crop side by side -->
                    <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
                        <!-- Trim -->
                        <Border Grid.Column="0" Classes="nested-card" Margin="0,0,4,0"
                                Classes.trim-dirty="{Binding IsTrimDirty}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Trim"
                                           Classes="nested-card-header" />
                                <Separator DockPanel.Dock="Top" />
                                <StackPanel Spacing="4" Margin="8,4,8,6">
                                    <Grid ColumnDefinitions="30,*,Auto" RowDefinitions="Auto,Auto">
                                        <TextBlock Text="In" VerticalAlignment="Center" />
                                        <TextBox x:Name="TrimInTextBox"
                                                 ToolTip.Tip="Start time to keep, in HH:MM:SS.mmm format. Earlier content is excluded from the output."
                                                 Grid.Column="1"
                                                 Classes="compact mono"
                                                 Text="{Binding TrimInDisplay}" />
                                        <Button Grid.Column="2"
                                                ToolTip.Tip="Set the trim start to the current preview position."
                                                Classes="xs"
                                                Content="Set"
                                                Command="{Binding SetTrimInCommand}"
                                                IsEnabled="{Binding HasMedia}" />

                                        <TextBlock Grid.Row="1" Text="Out"
                                                   VerticalAlignment="Center"
                                                   Margin="0,2,0,0" />
                                        <TextBox x:Name="TrimOutTextBox"
                                                 ToolTip.Tip="End time to keep, in HH:MM:SS.mmm format. Later content is excluded from the output."
                                                 Grid.Row="1" Grid.Column="1"
                                                 Classes="compact mono"
                                                 Text="{Binding TrimOutDisplay}"
                                                 Margin="0,2,0,0" />
                                        <Button Grid.Row="1" Grid.Column="2"
                                                ToolTip.Tip="Set the trim end to the current preview position."
                                                Classes="xs"
                                                Content="Set"
                                                Command="{Binding SetTrimOutCommand}"
                                                IsEnabled="{Binding HasMedia}"
                                                Margin="0,2,0,0" />
                                    </Grid>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Left"
                                                ToolTip.Tip="Clear the trim range and keep the full source duration."
                                                Classes="xs"
                                                Content="Clear"
                                                Command="{Binding ClearTrimCommand}"
                                                IsEnabled="{Binding HasMedia}" />
                                        <CheckBox DockPanel.Dock="Right"
                                                  Classes="compact"
                                                  Content="Apply to all"
                                                  ToolTip.Tip="Apply this trim to all source files"
                                                  IsChecked="{Binding ApplyTrimToAll}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Crop -->
                        <Border Grid.Column="1" Classes="nested-card" Margin="4,0,0,0"
                                Classes.crop-dirty="{Binding IsCropDirty}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Crop"
                                           Classes="nested-card-header" />
                                <Separator DockPanel.Dock="Top" />
                                <StackPanel Spacing="4" Margin="8,4,8,6">
                                    <Grid ColumnDefinitions="16,*,8,16,*"
                                          RowDefinitions="Auto,Auto">
                                        <TextBlock Classes="caption" Text="X" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 ToolTip.Tip="Horizontal offset of the crop rectangle from the left edge, in source pixels."
                                                 Classes="compact caption"
                                                 Text="{Binding CropX}" />
                                        <TextBlock Grid.Column="3" Classes="caption" Text="Y" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="4"
                                                 ToolTip.Tip="Vertical offset of the crop rectangle from the top edge, in source pixels."
                                                 Classes="compact caption"
                                                 Text="{Binding CropY}" />

                                        <TextBlock Grid.Row="1" Classes="caption" Text="W"
                                                   VerticalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 ToolTip.Tip="Width of the area to keep, in source pixels. Content outside the crop rectangle is removed."
                                                 Classes="compact caption"
                                                 Text="{Binding CropW}"
                                                 Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Classes="caption" Text="H"
                                                   VerticalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                        <TextBox Grid.Row="1" Grid.Column="4"
                                                 ToolTip.Tip="Height of the area to keep, in source pixels. Content outside the crop rectangle is removed."
                                                 Classes="compact caption"
                                                 Text="{Binding CropH}"
                                                 Margin="0,4,0,0" />
                                    </Grid>
                                    <TextBlock Classes="caption secondary"
                                               Text="{Binding CropDetectionStatus}"
                                               TextWrapping="Wrap" />
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                            <Button Classes="xs"
                                                    ToolTip.Tip="Clear the crop and keep the full source frame."
                                                    Content="Reset"
                                                    Command="{Binding ResetCropCommand}"
                                                    IsEnabled="{Binding HasMedia}" />
                                            <Button Classes="xs"
                                                    Content="Detect"
                                                    ToolTip.Tip="Detect crop from the current preview frame"
                                                    Command="{Binding DetectCropCommand}" />
                                        </StackPanel>
                                        <CheckBox DockPanel.Dock="Right"
                                                  Classes="compact"
                                                  Content="Apply to all"
                                                  ToolTip.Tip="Apply this crop to all source files"
                                                  IsChecked="{Binding ApplyCropToAll}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Video surface: fills remaining space -->
                <Border Background="Black" MinHeight="120">
                    <vlc:VideoView x:Name="VideoView"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch" />
                </Border>
            </DockPanel>
        </DockPanel>
    </Border>
</UserControl>
