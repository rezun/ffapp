<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:views="using:FFApp.Views"
             x:Class="FFApp.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel"
             x:CompileBindings="True">

    <DockPanel>

        <!-- THREE-COLUMN LAYOUT -->
        <Grid x:Name="MainGrid" ColumnDefinitions="320,6,*,6,320">

            <!-- LEFT COLUMN: Source list panel -->
            <views:SourceListPanelView Grid.Column="0"
                                       DataContext="{Binding SourceList}" />

            <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" />

            <!-- CENTER COLUMN: Preview + Preset bar + Output Settings (scrollable) -->
            <DockPanel Grid.Column="2">
                <!-- Command Preview (bottom of center column) -->
                <views:CommandPreviewView DockPanel.Dock="Bottom"
                                          DataContext="{Binding CommandPreview}" />

                <!-- Preview + Settings with optional splitter -->
                <Grid x:Name="PreviewSettingsGrid" RowDefinitions="Auto,Auto,*">
                    <!-- Video Preview (collapsible) -->
                    <views:VideoPreviewView x:Name="VideoPreviewPanel"
                                            Grid.Row="0"
                                            DataContext="{Binding VideoPreview}" />

                    <!-- Splitter between preview and settings (visible when expanded) -->
                    <GridSplitter Grid.Row="1" Height="6"
                                  ResizeDirection="Rows"
                                  IsVisible="{Binding VideoPreview.IsExpanded}" />

                    <!-- Preset bar + scrollable output settings -->
                    <DockPanel Grid.Row="2">
                        <Border DockPanel.Dock="Top"
                                Padding="16,10,8,2">
                            <StackPanel Spacing="4">
                                <Grid x:Name="PresetActions" ColumnDefinitions="*,Auto">
                                    <views:PresetBarView DataContext="{Binding Preset}" Margin="0,0,8,0" />
                                    <Button x:Name="OpenComparisonButton" Grid.Column="1"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Content="Compare encodes"
                                            Command="{Binding OpenComparisonCommand}"
                                            ToolTip.Tip="Open a separate comparison window for this source. Test short samples with independent encoding variants." />
                                </Grid>
                                <TextBlock Text="{Binding ComparisonStatus}" TextWrapping="Wrap"
                                           IsVisible="{Binding ComparisonStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <views:OutputPathView DataContext="{Binding OutputPath}"
                                                      Margin="8,8,8,0" />
                                <views:OutputSettingsView DataContext="{Binding OutputSettings}"
                                                         Margin="8,8,8,4" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="6" ResizeDirection="Columns" />

            <!-- RIGHT COLUMN: Job list panel -->
            <views:JobListPanelView Grid.Column="4"
                                    DataContext="{Binding JobList}" />

        </Grid>

    </DockPanel>
</UserControl>
