<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:views="using:FFApp.Views"
             x:Class="FFApp.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel"
             x:CompileBindings="True">

    <DockPanel>

        <!-- STATUS BAR: Active job progress (visible when running) -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,4"
                IsVisible="{Binding JobList.IsAnyJobRunning}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding JobList.StatusText}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <ProgressBar Grid.Column="1"
                             Value="{Binding JobList.StatusPercentage}"
                             Minimum="0"
                             Maximum="100"
                             Height="4"
                             VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding JobList.StatusPercentage, StringFormat={}{0:F0}%}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           MinWidth="36"
                           TextAlignment="Right"
                           Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- BOTTOM BAR: Command Preview (full width) -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0">
            <views:CommandPreviewView DataContext="{Binding CommandPreview}" />
        </Border>

        <!-- THREE-COLUMN LAYOUT -->
        <Grid x:Name="MainGrid" ColumnDefinitions="280,6,*,6,240">

            <!-- LEFT COLUMN: Source list panel -->
            <views:SourceListPanelView Grid.Column="0"
                                       DataContext="{Binding SourceList}" />

            <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" />

            <!-- CENTER COLUMN: Preview + Preset bar + Output Settings (scrollable) -->
            <DockPanel Grid.Column="2">
                <!-- Preview + Settings with optional splitter -->
                <Grid x:Name="PreviewSettingsGrid" RowDefinitions="Auto,Auto,*">
                    <!-- Video Preview (collapsible) -->
                    <views:VideoPreviewView Grid.Row="0"
                                            DataContext="{Binding VideoPreview}" />

                    <!-- Splitter between preview and settings (visible when expanded) -->
                    <GridSplitter Grid.Row="1" Height="6"
                                  ResizeDirection="Rows"
                                  IsVisible="{Binding VideoPreview.IsExpanded}" />

                    <!-- Preset bar + scrollable output settings -->
                    <DockPanel Grid.Row="2">
                        <Border DockPanel.Dock="Top"
                                Padding="16,10,8,2">
                            <views:PresetBarView DataContext="{Binding Preset}" />
                        </Border>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <views:OutputPathView DataContext="{Binding OutputPath}"
                                                      Margin="8,8,8,0" />
                                <views:OutputSettingsView DataContext="{Binding OutputSettings}"
                                                         Margin="8,8,8,4" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="6" ResizeDirection="Columns" />

            <!-- RIGHT COLUMN: Job list panel -->
            <views:JobListPanelView Grid.Column="4"
                                    DataContext="{Binding JobList}" />

        </Grid>

    </DockPanel>
</UserControl>
