<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:views="using:FFApp.Views"
             x:Class="FFApp.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel"
             x:CompileBindings="True">

    <Grid x:Name="MainGrid" ColumnDefinitions="250,6,*">

        <!-- Left Panel: Source/Queue Tabs -->
        <TabControl Grid.Column="0" Padding="2"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Source">
                <views:SourcePanelView DataContext="{Binding SourcePanel}" />
            </TabItem>
            <TabItem Header="Batch Jobs">
                <views:QueuePanelView DataContext="{Binding QueuePanel}" />
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" />

        <!-- Right Panel: vertical split -->
        <Grid x:Name="RightGrid" Grid.Column="2" RowDefinitions="3*,6,2*">

            <!-- Top: Preset bar + output summary + scrollable settings -->
            <DockPanel Grid.Row="0">
                <!-- Preset bar pinned at top -->
                <views:PresetBarView DockPanel.Dock="Top"
                                     DataContext="{Binding Preset}"
                                     Margin="8,8,8,10" />

                <!-- Output summary pinned below preset bar -->
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding OutputSettings.ValidationText}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Margin="6,0,6,2"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           IsVisible="{Binding OutputSettings.ValidationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Scrollable output settings -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <views:OutputSettingsView DataContext="{Binding OutputSettings}"
                                             Margin="6,0,6,4" />
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Row="1" Height="6" ResizeDirection="Rows" />

            <!-- Bottom: Command Preview (collapsible) + Execution (always visible) -->
            <DockPanel Grid.Row="2">
                <views:CommandPreviewView DockPanel.Dock="Top"
                                          DataContext="{Binding CommandPreview}" />
                <views:ExecutionView DataContext="{Binding Execution}" />
            </DockPanel>

        </Grid>
    </Grid>
</UserControl>
