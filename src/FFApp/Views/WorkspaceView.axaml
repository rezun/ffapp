<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFApp.ViewModels"
             xmlns:views="using:FFApp.Views"
             x:Class="FFApp.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel"
             x:CompileBindings="True">

    <DockPanel>

        <!-- STATUS BAR: Active job progress (visible when running) -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,4"
                IsVisible="{Binding JobsPanel.IsAnyJobRunning}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding JobsPanel.StatusText}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <ProgressBar Grid.Column="1"
                             Value="{Binding JobsPanel.StatusPercentage}"
                             Minimum="0"
                             Maximum="100"
                             Height="4"
                             VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding JobsPanel.StatusPercentage, StringFormat={}{0:F0}%}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           MinWidth="36"
                           TextAlignment="Right"
                           Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- BOTTOM BAR: Command Preview (full width) -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0">
            <views:CommandPreviewView DataContext="{Binding CommandPreview}" />
        </Border>

        <!-- THREE-COLUMN LAYOUT -->
        <Grid x:Name="MainGrid" ColumnDefinitions="280,6,*,6,240">

            <!-- LEFT COLUMN: Source panel (always visible) -->
            <views:SourcePanelView Grid.Column="0"
                                   DataContext="{Binding SourcePanel}" />

            <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" />

            <!-- CENTER COLUMN: Preset bar + Output Settings (scrollable) -->
            <DockPanel Grid.Column="2">
                <!-- Preset bar pinned at top -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <views:PresetBarView DataContext="{Binding Preset}" />
                </Border>

                <!-- Scrollable output settings -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <views:OutputSettingsView DataContext="{Binding OutputSettings}"
                                             Margin="8,8,8,4" />
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="6" ResizeDirection="Columns" />

            <!-- RIGHT COLUMN: Jobs panel (Single / Queue toggle) -->
            <views:JobsPanelView Grid.Column="4"
                                 DataContext="{Binding JobsPanel}" />

        </Grid>

    </DockPanel>
</UserControl>
