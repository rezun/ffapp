<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FFRux.ViewModels"
        xmlns:views="using:FFRux.Views"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="FFRux.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/ffrux.ico"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="600"
        DragDrop.AllowDrop="True">

    <!-- macOS shows this in the system menu bar; Windows and Linux show it in the NativeMenuBar below. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="Info">
                <NativeMenu>
                    <NativeMenuItem Header="FFRux" IsEnabled="False" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="Open logs folder" Click="OnOpenLogsFolder" />
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <DockPanel>
        <NativeMenuBar DockPanel.Dock="Top" />
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Height="40" Padding="8,0" BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0">
            <Border.Styles>
                <!-- The default pointer placement has no room below the window edge, so the tooltip
                     slides up under the pointer and swallows the click. Open it above the control. -->
                <Style Selector=":is(Control)">
                    <Setter Property="ToolTip.Placement" Value="Top" />
                    <Setter Property="ToolTip.VerticalOffset" Value="-6" />
                </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="*,Auto,Auto">
                <!-- Ready or blocked -->
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding StatusMessage}"
                           Classes.status-error="{Binding IsStatusError}" Classes.status-warning="{Binding IsStatusWarning}"
                           Classes.status-ok="{Binding IsStatusOk}" Classes.secondary="{Binding StatusSeverity, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsRunning" />
                            <Binding Path="!HasResult" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>

                <!-- Running -->
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding IsRunning}">
                    <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" MinWidth="150" />
                    <ProgressBar Width="320" Height="4" MinHeight="4" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                 Value="{Binding ProgressPercent}" IsIndeterminate="{Binding ProgressIsIndeterminate}" />
                    <TextBlock Classes="caption secondary" Text="{Binding RemainingText}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Finished, failed or canceled -->
                <DockPanel VerticalAlignment="Center" IsVisible="{Binding HasResult}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
                        <Button Classes="sm" Content="Show in folder" Command="{Binding ShowInFolderCommand}" IsVisible="{Binding ResultSucceeded}" />
                        <Button Classes="sm" Content="Show log" Command="{Binding ShowLogCommand}" />
                        <Button Classes="sm" Content="Open log file" Command="{Binding OpenLogFileCommand}"
                                IsVisible="{Binding HasResultLog}"
                                ToolTip.Tip="Open the saved log of this remux in your default text editor." />
                        <Button Classes="sm ghost" Content="Dismiss" Command="{Binding DismissResultCommand}" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding ResultText}"
                               ToolTip.Tip="{Binding ResultDetail}"
                               Classes.status-error="{Binding IsStatusError}" Classes.status-warning="{Binding IsStatusWarning}"
                               Classes.status-ok="{Binding IsStatusOk}" />
                </DockPanel>

                <TextBlock Grid.Column="1" Classes="caption secondary" Margin="12,0" VerticalAlignment="Center"
                           Text="{Binding EstimatedSizeText}" IsVisible="{Binding !IsRunning}" />
                <Panel Grid.Column="2" VerticalAlignment="Center">
                    <Button Classes="accent" Content="Start remux" Command="{Binding StartCommand}" IsVisible="{Binding !IsRunning}"
                            ToolTip.Tip="Write the output file. FFRux first tests the combination with a short remux." />
                    <Button Classes="danger" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}"
                            ToolTip.Tip="Stop FFmpeg. The incomplete file is deleted and an existing output file stays as it was." />
                </Panel>
            </Grid>
        </Border>

        <!-- Three columns -->
        <Grid ColumnDefinitions="296,6,*,6,296">
            <views:SourcesPanelView Grid.Column="0" />
            <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" Background="Transparent" />
            <views:TracksView Grid.Column="2" />
            <GridSplitter Grid.Column="3" Width="6" ResizeDirection="Columns" Background="Transparent" />
            <views:PropertiesView Grid.Column="4" DataContext="{Binding Properties}" />
        </Grid>
    </DockPanel>
</Window>
