<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FFRux.ViewModels"
        xmlns:m="using:FFRux.Models"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
        x:Class="FFRux.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="FFRux"
        Width="960" Height="640"
        MinWidth="640" MinHeight="400">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="panel-header" Text="Source files" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Open files…" Command="{Binding PickFilesCommand}" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="12,4">
            <TextBlock Classes="caption secondary" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
        </Border>

        <Border Classes="card" Margin="12,0,12,4">
            <Panel>
                <TextBlock Classes="secondary"
                           IsVisible="{Binding !HasFiles}"
                           Text="Open a video with FFRux, or choose files to remux."
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ListBox Classes="dense"
                         IsVisible="{Binding HasFiles}"
                         ItemsSource="{Binding Files}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:SourceFileItem">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                                <TextBlock Classes="caption secondary" Text="{Binding Summary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Panel>
        </Border>
    </DockPanel>
</Window>
