<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FFRux.ViewModels"
             xmlns:conv="using:FFRux.Converters"
             x:Class="FFRux.Views.TracksView"
             x:DataType="vm:MainWindowViewModel">

    <DockPanel Margin="2,8,2,8">

        <!-- Command preview and log -->
        <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,8,0,0" DataContext="{Binding CommandPreview}"
                x:DataType="vm:CommandPreviewViewModel">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="8,4,8,4">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <ToggleButton Classes="tab" Content="Command preview" IsChecked="{Binding ShowCommand, Mode=OneWay}"
                                      Command="{Binding SelectCommandCommand}"
                                      ToolTip.Tip="The FFmpeg and mkvpropedit commands for the current settings." />
                        <ToggleButton Classes="tab" Content="Log" IsChecked="{Binding ShowLog, Mode=OneWay}"
                                      Command="{Binding SelectLogCommand}"
                                      ToolTip.Tip="The output of FFmpeg and mkvpropedit from the last job." />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="xs" Content="Copy" Margin="0,0,4,0" Command="{Binding CopyCommand}" VerticalAlignment="Center"
                            IsVisible="{Binding IsExpanded}" ToolTip.Tip="Copy the text shown below." />
                    <Button Grid.Column="3" Classes="xs ghost" Content="{Binding ToggleText}" Command="{Binding ToggleExpandedCommand}" VerticalAlignment="Center" />
                </Grid>
                <TextBox IsVisible="{Binding IsExpanded}" Classes="mono caption" Text="{Binding VisibleText, Mode=OneWay}"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180" Margin="8,0,8,8"
                         PlaceholderText="Nothing to show yet." />
            </DockPanel>
        </Border>

        <!-- Tracks card -->
        <Border Classes="card">
            <Panel>
                <!-- Empty state -->
                <DockPanel IsVisible="{Binding IsEmpty}">
                    <TextBlock DockPanel.Dock="Top" Classes="card-header" Text="Tracks" />
                    <Panel Margin="8,4,8,8">
                        <Rectangle Classes="drop-area" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <TextBlock Text="Drop media or subtitle files here" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource CardHeaderBrush}" />
                            <TextBlock Classes="caption secondary" HorizontalAlignment="Center"
                                       Text="MKV, MP4, MOV, TS, audio files, SRT, ASS, VTT, SUP and more" />
                            <Button Classes="accent" HorizontalAlignment="Center" Content="Add source files"
                                    Command="{Binding AddSourcesCommand}" />
                            <TextBlock Classes="caption" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                                       TextAlignment="Center" Foreground="{DynamicResource ValidationErrorBrush}"
                                       Text="{Binding ToolsMessage}"
                                       IsVisible="{Binding ToolsMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </Panel>
                </DockPanel>

                <!-- Table -->
                <DockPanel IsVisible="{Binding HasSources}">
                    <DockPanel DockPanel.Dock="Top" Margin="8,4,8,2">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                            <TextBlock Classes="caption secondary" Text="{Binding TracksSummary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Classes="icon" Command="{Binding MoveSelectedUpCommand}" ToolTip.Tip="Move the selected track up (Alt+Up)"
                                    AutomationProperties.Name="Move track up">
                                <PathIcon Data="{StaticResource IconChevronUp}" />
                            </Button>
                            <Button Classes="icon" Command="{Binding MoveSelectedDownCommand}" ToolTip.Tip="Move the selected track down (Alt+Down)"
                                    AutomationProperties.Name="Move track down">
                                <PathIcon Data="{StaticResource IconChevronDown}" />
                            </Button>
                        </StackPanel>
                        <TextBlock Classes="card-header" Margin="0" Text="Tracks" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Compatibility -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                            Padding="8,6,8,8">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Right" Classes="caption secondary" Text="{Binding IssuesSummary}"
                                           VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Classes="caption status-ok" Text="{Binding AllFitText, StringFormat='✓ {0}'}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding AllFitText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="Compatibility" FontWeight="SemiBold" Foreground="{DynamicResource CardHeaderBrush}" />
                            </DockPanel>
                            <ScrollViewer MaxHeight="120" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasIssues}">
                                <ItemsControl ItemsSource="{Binding Issues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:IssueViewModel">
                                            <Grid ColumnDefinitions="18,*" Margin="0,1">
                                                <TextBlock Text="{Binding Symbol}" Classes.status-error="{Binding IsError}"
                                                           Classes.status-warning="{Binding IsWarning}" Classes.secondary="{Binding IsInfo}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Column headers -->
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                            Padding="10,4,8,4">
                        <!-- Keep these columns in sync with the track row template below -->
                        <Grid ColumnDefinitions="28,26,88,64,1.3*,124,*,196">
                            <TextBlock Grid.Column="2" Classes="column-header" Text="Codec" />
                            <TextBlock Grid.Column="3" Classes="column-header" Text="Language" />
                            <TextBlock Grid.Column="4" Classes="column-header" Text="Name" />
                            <TextBlock Grid.Column="5" Classes="column-header" Text="Flags" />
                            <TextBlock Grid.Column="6" Classes="column-header" Text="Details" />
                            <TextBlock Grid.Column="7" Classes="column-header" Text="{Binding StatusColumnHeader}" />
                        </Grid>
                    </Border>

                    <ListBox x:Name="TrackList" Classes="tracks" ItemsSource="{Binding Rows}" SelectionMode="Multiple"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.KeyBindings>
                            <KeyBinding Gesture="Alt+Up" Command="{Binding MoveSelectedUpCommand}" />
                            <KeyBinding Gesture="Alt+Down" Command="{Binding MoveSelectedDownCommand}" />
                        </ListBox.KeyBindings>
                        <ListBox.DataTemplates>
                            <DataTemplate DataType="vm:TrackGroupViewModel">
                                <Border Background="{DynamicResource TableGroupBackgroundBrush}" Padding="8,0" Height="24">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Classes="caption secondary" FontWeight="SemiBold" Text="{Binding Label}" />
                                        <TextBlock Classes="caption secondary" Text="{Binding CountText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:TrackViewModel">
                                <Border BorderBrush="{DynamicResource TableRowLineBrush}" BorderThickness="0,0,0,1" Padding="8,0"
                                        Background="Transparent" ToolTip.Tip="{Binding StatusDetail}"
                                        ToolTip.ShowDelay="700">
                                    <Grid Classes="track-row" Classes.off="{Binding !Enabled}"
                                          ColumnDefinitions="28,26,88,64,1.3*,124,*,196">
                                        <CheckBox IsChecked="{Binding Enabled}" IsEnabled="{Binding IsEditable}" MinWidth="0" Padding="0"
                                                  AutomationProperties.Name="Include track" ToolTip.Tip="Include this track in the output (Space)." />
                                        <Border Grid.Column="1" Classes="marker"
                                                Background="{Binding MarkerIndex, Converter={x:Static conv:MarkerBrushConverter.Instance}}">
                                            <TextBlock Text="{Binding SourceNumber}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding CodecLabel}" />
                                        <TextBlock Grid.Column="3" Text="{Binding LanguageCode}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Name}" />
                                        <ItemsControl Grid.Column="5" ItemsSource="{Binding FlagChips}" ClipToBounds="True">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border Classes="chip">
                                                        <TextBlock Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.Column="6" Classes="caption secondary" Text="{Binding DetailsText}" />
                                        <TextBlock Grid.Column="7" Classes.caption="{Binding !Enabled}" Classes.secondary="{Binding !Enabled}"
                                                   Classes.status-ok="{Binding IsStatusCopy}" Classes.status-convert="{Binding IsStatusConvert}"
                                                   Classes.status-warning="{Binding IsStatusWarning}" Classes.status-error="{Binding IsStatusError}">
                                            <Run Text="{Binding StatusSymbol}" />
                                            <Run Text="{Binding StatusText}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>
                </DockPanel>
            </Panel>
        </Border>
    </DockPanel>
</UserControl>
